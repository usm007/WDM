<Window x:Class="WDM.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Download Manager — Setup" Height="380" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI">
    
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Border Width="48" Height="48" CornerRadius="12" Background="#1677D2" Margin="0,0,16,0">
                    <TextBlock Text="W" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Windows Download Manager" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="Setup &amp; Browser Extension Installer" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Content Body -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1">
                <StackPanel x:Name="SetupPanel">
                    <TextBlock Text="Installation Folder" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Background="#0F172A" BorderBrush="#475569" BorderThickness="1">
                            <TextBox x:Name="InstallFolderBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" IsReadOnly="True" />
                        </Border>
                    </Grid>

                    <CheckBox x:Name="DesktopShortcutBox" Content="Create Desktop Shortcut" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,10" />
                    <CheckBox x:Name="StartMenuShortcutBox" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,10" />
                    <CheckBox x:Name="LaunchAfterBox" Content="Launch WDM when installation finishes" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,16" />

                    <!-- Status & Progress -->
                    <TextBlock x:Name="StatusText" Text="Ready to install" FontSize="13" Foreground="#38BDF8" FontWeight="Medium" Margin="0,0,0,6" />
                    <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#0F172A" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="v1.0.0 • Production Build" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" Click="CancelClick" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button x:Name="InstallButton" Content="Install Now" Width="110" Height="34" Click="InstallClick" Background="#1677D2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
