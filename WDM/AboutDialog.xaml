<Window x:Class="WDM.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WDM"
        Icon="Assets/WDM.ico"
        Width="460"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}">
    <Border Padding="20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" FontSize="28" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Windows Download Manager" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Version 6.42 Modern Edition (64-bit)" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                    <TextBlock Text="High-Speed Multi-Threaded Download Accelerator" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Product Details -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,2">
                        <TextBlock Text="License Type:" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                        <TextBlock Text="Full Version (Lifetime License)" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Success}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Browser Integration:" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                        <TextBlock Text="Active (127.0.0.1:17530)" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Engine Capabilities:" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                        <TextBlock Text="16-Thread Chunking, Speed Limiter, Scheduler" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Button.Accent}" IsDefault="True" IsCancel="True" MinWidth="100" Click="CloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
