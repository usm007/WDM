<Window x:Class="WDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="WDM - Windows Download Manager"
        Icon="Assets/WDM.ico"
        Width="1150"
        Height="720"
        MinWidth="860"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <vm:TaskStatusToColorConverter x:Key="StatusColor" />
        <vm:TextToVisibilityConverter x:Key="TextToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:RetryVisibilityConverter x:Key="RetryVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenAddDialogCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OptionsCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Key="F5" Command="{Binding RetryCommand}" />
    </Window.InputBindings>

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Classic Menu Bar -->
            <RowDefinition Height="Auto" /> <!-- IDM Action Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Area (Categories Sidebar + DataGrid) -->
            <RowDefinition Height="28" />   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Classic IDM Menu Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent">
                <MenuItem Header="Tasks" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Add New Download..." Command="{Binding OpenAddDialogCommand}" InputGestureText="Ctrl+N" />
                    <Separator />
                    <MenuItem Header="Pause All Downloads" Command="{Binding PauseAllCommand}" />
                    <MenuItem Header="Resume All Downloads" Command="{Binding ResumeAllCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuExit_Click" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="File" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Show Progress Window..." Command="{Binding ShowProgressDialogCommand}" />
                    <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}" />
                    <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" />
                    <MenuItem Header="Open Folder" Command="{Binding RevealCommand}" />
                    <Separator />
                    <MenuItem Header="Delete Selected" Command="{Binding RemoveCommand}" InputGestureText="Del" />
                    <MenuItem Header="Delete Selected with File" Command="{Binding RemoveWithFileCommand}" />
                    <MenuItem Header="Delete Completed" Command="{Binding ClearCompletedCommand}" />
                </MenuItem>
                <MenuItem Header="Downloads" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Start Queue" Command="{Binding StartQueueCommand}" />
                    <MenuItem Header="Stop Queue" Command="{Binding StopQueueCommand}" />
                    <Separator />
                    <MenuItem Header="Scheduler..." Command="{Binding ScheduleCommand}" />
                    <MenuItem Header="Options..." Command="{Binding OptionsCommand}" InputGestureText="Ctrl+," />
                </MenuItem>
                <MenuItem Header="View" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Toggle Sidebar" Command="{Binding ToggleSidebarCommand}" />
                    <MenuItem Header="Clear Search" Command="{Binding ClearSearchCommand}" />
                </MenuItem>
                <MenuItem Header="Help" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="About WDM..." Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. Iconic IDM Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons Cluster -->
                <ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Add URL -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding OpenAddDialogCommand}" ToolTip="Add Download URL (Ctrl+N)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Add URL" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Resume -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding ResumeCommand}" ToolTip="Resume Download (Space)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Resume" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding PauseCommand}" ToolTip="Stop Download (Space)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE769;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Stop" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Stop All -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding PauseAllCommand}" ToolTip="Stop All Active Downloads">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" />
                                <TextBlock Text="Stop All" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="36" Background="{DynamicResource Brush.Border}" Margin="6,0" VerticalAlignment="Center" />

                        <!-- Delete -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding RemoveCommand}" ToolTip="Delete Selected (Del)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" />
                                <TextBlock Text="Delete" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Delete Completed -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding ClearCompletedCommand}" ToolTip="Delete All Completed Downloads">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE894;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                                <TextBlock Text="Delete Completed" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="36" Background="{DynamicResource Brush.Border}" Margin="6,0" VerticalAlignment="Center" />

                        <!-- Options -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding OptionsCommand}" ToolTip="Options (Ctrl+,)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Options" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Scheduler -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding ScheduleCommand}" ToolTip="Schedule Download">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Scheduler" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Start Queue -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding StartQueueCommand}" ToolTip="Start Download Queue">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Start Queue" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Stop Queue -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding StopQueueCommand}" ToolTip="Stop Download Queue">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE899;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" />
                                <TextBlock Text="Stop Queue" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="36" Background="{DynamicResource Brush.Border}" Margin="6,0" VerticalAlignment="Center" />

                        <!-- Grabber -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding GrabberCommand}" ToolTip="Media Grabber / Site Sniffer">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Grabber" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tell a Friend / About -->
                        <Button Style="{StaticResource Button.IDMToolbar}" Command="{Binding AboutCommand}" ToolTip="About Windows Download Manager">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="Tell a Friend" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Search Input Field on Toolbar Far Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                    <TextBox Width="200" Height="32" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search downloads by file name or URL">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="bd"
                                        Background="{DynamicResource Brush.Bg}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,4,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Command="{Binding ClearSearchCommand}"
                                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" Width="22" Height="22" ToolTip="Clear search">
                                            <TextBlock Text="&#xE10A;" FontFamily="{StaticResource Font.Icon}" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextDim}" Margin="4,0,8,0" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Main Content Body (Sidebar + DataGrid Table) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Iconic IDM Categories Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Categories Header -->
                    <DockPanel Grid.Row="0" Margin="14,4,14,8" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleSidebarCommand}" Width="20" Height="20" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource Font.Icon}" FontSize="11" />
                        </Button>
                    </DockPanel>

                    <!-- Category Items Hierarchy List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             Style="{StaticResource ListBox.Sidebar}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Sidebar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="14,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="4,2"
                                            Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"
                                            Grid.ColumnSpan="3" />
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.CategoryColorHex, RelativeSource={RelativeSource AncestorType=ListBoxItem}, TargetNullValue={StaticResource Brush.Accent}}"
                                               Visibility="{Binding IsSeparator, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding CountText, Converter={StaticResource TextToVis}}">
                                        <TextBlock Text="{Binding CountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Browser Catching Status Banner -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6" Padding="10,8" Margin="8,6"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Browser Listener" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                            <TextBlock Text="127.0.0.1:17530" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" Margin="12,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Collapse / Expand Toggle Button -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="4">
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding CollapseToolTip}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CollapseIcon}" FontFamily="{StaticResource Font.Icon}" FontSize="13" />
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- IDM Download DataGrid Table -->
            <Grid Grid.Column="1">
                <DataGrid x:Name="TaskGrid"
                          ItemsSource="{Binding TasksView}"
                          SelectedItem="{Binding SelectedTask}"
                          SelectionChanged="TaskGrid_SelectionChanged"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          MouseDoubleClick="TaskGrid_MouseDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="A" Modifiers="Control" Command="SelectAll" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Show Progress Window..." Command="{Binding ShowProgressDialogCommand}" FontWeight="Bold" />
                            <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" />
                            <MenuItem Header="Open Containing Folder" Command="{Binding RevealCommand}" />
                            <MenuItem Header="Copy Download URL" Command="{Binding CopyUrlCommand}" />
                            <Separator />
                            <MenuItem Header="Pause" Command="{Binding PauseCommand}" />
                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                            <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                            <MenuItem Header="Retry" Command="{Binding RetryCommand}" Visibility="{Binding SelectedTask.Status, Converter={StaticResource RetryVis}}" />
                            <Separator />
                            <MenuItem Header="Schedule Download..." Command="{Binding ScheduleCommand}" />
                            <MenuItem Header="Priority">
                                <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
                                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                            </MenuItem>
                            <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}" />
                            <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}" />
                            <Separator />
                            <MenuItem Header="Remove from List" Command="{Binding RemoveCommand}" />
                            <MenuItem Header="Remove and Delete File" Command="{Binding RemoveWithFileCommand}" />
                            <MenuItem Header="Remove All Completed" Command="{Binding ClearCompletedCommand}" />
                            <Separator />
                            <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Name & Category Icon -->
                        <DataGridTemplateColumn Header="File Name" Width="3*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TypeIcon}" FontFamily="{StaticResource Font.Icon}" FontSize="13" Foreground="{Binding CategoryColorHex}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource Brush.TextDim}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Q Column (IDM Queue Indicator) -->
                        <DataGridTextColumn Header="Q" Width="32" HeaderStyle="{StaticResource Header.Right}"
                                            Binding="{Binding QueueText}"
                                            ElementStyle="{StaticResource Cell.Right}" />

                        <!-- Size -->
                        <DataGridTextColumn Header="Size" Width="85" HeaderStyle="{StaticResource Header.Right}"
                                            Binding="{Binding SizeText}"
                                            ElementStyle="{StaticResource Cell.Right}" />

                        <!-- Status & Progress -->
                        <DataGridTemplateColumn Header="Status / Progress" Width="2*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ProgressBar Grid.Row="0" Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBar.Download}" />
                                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Time Left (ETA) -->
                        <DataGridTextColumn Header="Time Left" Width="85" HeaderStyle="{StaticResource Header.Right}"
                                            Binding="{Binding Eta}"
                                            ElementStyle="{StaticResource Cell.RightDim}" />

                        <!-- Speed / Transfer Rate -->
                        <DataGridTextColumn Header="Transfer Rate" Width="95" HeaderStyle="{StaticResource Header.Right}"
                                            Binding="{Binding SpeedText}"
                                            ElementStyle="{StaticResource Cell.Right}" />

                        <!-- Added Date -->
                        <DataGridTextColumn Header="Added Date" Width="105" HeaderStyle="{StaticResource Header.Right}"
                                            Binding="{Binding AddedAt, StringFormat='{}{0:MMM dd HH:mm}'}"
                                            ElementStyle="{StaticResource Cell.RightDim}" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty Queue IDM State Placeholder -->
                <Border Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" FontSize="32" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No Downloads Yet" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Paste a download link or start a download in your browser." Foreground="{DynamicResource Brush.TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Content="+ Add Download" Style="{StaticResource Button.Accent}" Command="{Binding OpenAddDialogCommand}" HorizontalAlignment="Center" Width="150" />
                    </StackPanel>
                </Border>

                <!-- Floating Bulk Action Bar -->
                <Border x:Name="BulkBar"
                        Height="44"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom">
                    <DockPanel Margin="16,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding BulkCountText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Pause" Style="{StaticResource Button.Toolbar}" Command="{Binding BulkPauseCommand}" />
                            <Button Content="Resume" Style="{StaticResource Button.Toolbar}" Command="{Binding BulkResumeCommand}" Margin="6,0,0,0" />
                            <Button Content="Priority: High" Style="{StaticResource Button.Toolbar}" Command="{Binding BulkPriorityHighCommand}" Margin="6,0,0,0" />
                            <Button Content="Priority: Normal" Style="{StaticResource Button.Toolbar}" Command="{Binding BulkPriorityNormalCommand}" Margin="6,0,0,0" />
                            <Button Content="Delete" Style="{StaticResource Button.Toolbar}" Command="{Binding BulkRemoveCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar & Speed Sparkline -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="SparklineCanvas" Width="100" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusRightText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
