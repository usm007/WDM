<Window x:Class="WDM.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Download"
        Icon="Assets/WDM.ico"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="FileNameText" Text="Schedule download" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,0,0,12" />

        <TextBlock Text="Start at" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Time" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="HourBox" SelectedIndex="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Minute" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="MinuteBox" SelectedIndex="0" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Toolbar}" IsCancel="True" MinWidth="90" />
            <Button Content="Schedule" Style="{StaticResource Button.Accent}" Click="OkClick" MinWidth="100" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

