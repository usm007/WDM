<Window x:Class="WDM.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Download"
        Icon="Assets/WDM.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}">
    <Border Padding="24,20" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="10">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Add New Download" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Paste URL or customize options before starting" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- URL Field -->
            <TextBlock Text="DOWNLOAD URL" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center" />
            
            <!-- Metadata & Capability Callout Badge -->
            <Border x:Name="ProbeBadge" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="10,6" Margin="0,6,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="ProbeIcon" FontFamily="{StaticResource Font.Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProbeText" Text="Calculating size and capabilities..." FontSize="11" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="DuplicateWarning" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Brush.Warning}" Margin="0,4,0,0"
                       Text="This URL already exists in your download list." />

            <!-- Save To Folder Field -->
            <TextBlock Text="SAVE LOCATION" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource Button.Toolbar}" Click="BrowseClick" Margin="8,0,0,0" />
            </Grid>

            <!-- File Name Field -->
            <TextBlock Text="FILE NAME" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBox x:Name="NameBox" VerticalContentAlignment="Center" />

            <!-- Options Grid (Connections, Speed Limit, Category) -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="THREADS" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="ChunksBox">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="16" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                    <TextBlock Text="SPEED LIMIT (KB/S)" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="SpeedBox" Text="0" ToolTip="0 = Unlimited speed" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="CATEGORY" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged">
                        <ComboBoxItem Content="Auto detect" Tag="Auto" />
                        <ComboBoxItem Content="Video" Tag="Video" />
                        <ComboBoxItem Content="Music" Tag="Music" />
                        <ComboBoxItem Content="Document" Tag="Document" />
                        <ComboBoxItem Content="Compressed" Tag="Compressed" />
                        <ComboBoxItem Content="Program" Tag="Program" />
                        <ComboBoxItem Content="Other" Tag="Other" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Schedule / Start Radio Options -->
            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                <DockPanel>
                    <RadioButton x:Name="StartNow" GroupName="Start" Content="Start immediately" IsChecked="True" Checked="StartNow_Checked" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="StartLater" GroupName="Start" Content="Schedule:" Checked="StartLater_Checked" VerticalAlignment="Center" />
                        <TextBox x:Name="LaterTimeBox" Width="140" Margin="8,0,0,0" IsEnabled="False" VerticalContentAlignment="Center"
                                 ToolTip="Format: yyyy-MM-dd HH:mm" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dialog Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource Button.Toolbar}" IsCancel="True" MinWidth="90" />
                <Button x:Name="OkButton" Content="Start Download" Style="{StaticResource Button.Accent}" Click="OkClick" MinWidth="130" Margin="10,0,0,0" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
