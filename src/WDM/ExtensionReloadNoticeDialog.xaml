<Window x:Class="WDM.ExtensionReloadNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extension Update Notice — WDM"
        Icon="Assets/WDM.ico"
        Width="580"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="24,20,24,20">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0457;" FontFamily="{StaticResource Font.Icon}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="WDM Updated" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="SubtitleText" Text="Please reload your browser extension to apply updates." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Warning Card -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="&#xF0028;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reload Chrome / Edge Browser Extension" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                    </DockPanel>
                    
                    <TextBlock Text="WDM has updated its background extension scripts. If you use Chrome, Edge, Brave, or Opera, please reload the extension in your browser so the latest version is loaded:"
                               FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18" />

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="1. Click 'Open Extensions Page' below (chrome://extensions or edge://extensions)." FontSize="11.5" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                            <TextBlock Text="2. Find 'WDM Download Catcher' and click the 🔄 Reload icon on its card." FontSize="11.5" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                            <TextBlock Text="   (Or toggle Developer Mode off &amp; on to refresh all unpacked extensions)." FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FeedbackText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Open Extensions Page" Style="{StaticResource Button.Accent}" Click="OpenExtensions_Click" Height="32" Padding="14,0" Margin="0,0,8,0" />
                    <Button Content="Copy Extension Path" Style="{StaticResource Button.Secondary}" Click="CopyPath_Click" Height="32" Padding="12,0" Margin="0,0,8,0" />
                    <Button Content="Got It" Style="{StaticResource Button.Secondary}" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="80" Height="32" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
