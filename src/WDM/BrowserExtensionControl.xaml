<UserControl x:Class="WDM.BrowserExtensionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             RenderOptions.ClearTypeHint="Enabled"
             Background="{DynamicResource Brush.Surface}">
    <!-- Main Body -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,18">
            <!-- Top Back Button -->
            <ui:Button Appearance="Secondary" Click="CloseClick" Height="32" Padding="10,0" Margin="0,0,0,14" HorizontalAlignment="Left" ToolTip="Return to downloads list (Esc)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 6,1 L 2,5 L 6,9 M 2,5 L 11,5"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center"
                          Margin="0,0,7,0"
                          SnapsToDevicePixels="True" />
                    <TextBlock Text="Back to Downloads" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
            </ui:Button>

            <!-- Header with Extension Icon -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Install Browser Extension" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Catch downloads automatically from Chrome, Edge, Brave, or Firefox."
                       FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,16" />

            <!-- Section 1: Chrome / Edge / Chromium -->
            <TextBlock Text="Chrome, Edge &amp; Chromium" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <ui:Button x:Name="CopyPathButton" Content="Copy Extension Path" Appearance="Secondary" Click="CopyPath_Click" Height="32" Padding="12,0" Margin="0,0,8,0" />
                <ui:Button Content="Open Extensions Page" Appearance="Secondary" Click="OpenExtensions_Click" Height="32" Padding="12,0" Margin="0,0,10,0" />
                <TextBlock x:Name="FeedbackText" Text="" FontSize="12" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="1. Click 'Copy Extension Path', then click 'Open Extensions Page'." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,3" />
            <TextBlock Text="2. Turn on 'Developer mode' (top right), click 'Load unpacked', and paste the folder path." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,16" />

            <!-- Section 2: Firefox -->
            <TextBlock Text="Firefox" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="Open Firefox Add-ons Page" Appearance="Secondary" Click="OpenFirefoxAddonPage_Click" Height="32" Padding="12,0" />
            </StackPanel>
            <TextBlock Text="Install permanently from the Firefox Add-ons store with one click." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,20" />

            <!-- Section 3: More Help & Deep-Dive Guide -->
            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <DockPanel LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Click="OpenMoreHelp_Click" Height="32" Padding="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="More Help" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="↗" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Why is manual setup required?" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Explore our illustrated visual guide explaining browser security sandboxes and step-by-step setup." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
