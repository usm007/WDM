<UserControl x:Class="WDM.BrowserExtensionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             RenderOptions.ClearTypeHint="Enabled"
             Background="{DynamicResource Brush.Surface}">
    <!-- Main Body -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,18">
            <!-- Top Back Button -->
            <ui:Button Appearance="Secondary" Click="CloseClick" Height="32" Padding="10,0" Margin="0,0,0,14" HorizontalAlignment="Left" ToolTip="Return to downloads list (Esc)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 6,1 L 2,5 L 6,9 M 2,5 L 11,5"
                          Stroke="{DynamicResource Brush.Accent}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center"
                          Margin="0,0,7,0"
                          SnapsToDevicePixels="True" />
                    <TextBlock Text="Back to Downloads" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
            </ui:Button>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Browser Extension Setup" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Catch downloads automatically from Chrome, Edge, Brave, or Firefox."
                       FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,20" />

            <!-- Section 1: Chrome / Edge / Chromium -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Globe24" FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Chrome, Edge &amp; Chromium" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Single-action button: copies path + opens extensions page -->
            <ui:Button x:Name="SetupChromeBtn"
                       Content="Open Extensions Page  →"
                       Appearance="Secondary"
                       Height="34" Padding="14,0"
                       HorizontalAlignment="Left"
                       Click="SetupChrome_Click"
                       Margin="0,0,0,10"
                       ToolTip="Copies the extension folder path to clipboard and opens chrome://extensions" />

            <!-- Post-click 2-step panel (hidden until button clicked) -->
            <Border x:Name="ChromeStepsPanel" Visibility="Collapsed"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="14,11"
                    Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"
                               Text="✓ Extension folder path copied to clipboard" Margin="0,0,0,8" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.Text}" FontWeight="Medium"
                               Text="Two quick steps in Chrome:" Margin="0,0,0,6" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.TextDim}"
                               Text="1.  Turn on 'Developer mode' (toggle in the top-right corner)." Margin="0,0,0,3" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource Brush.TextDim}"
                               Text="2.  Click 'Load unpacked', paste the path, and click OK." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="FeedbackText" Text="" FontSize="11.5"
                       FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,20" />

            <!-- Section 2: Firefox -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Firefox" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>
            <ui:Button Content="Install Firefox Extension  →" Appearance="Secondary"
                       HorizontalAlignment="Left" Height="34" Padding="14,0"
                       Click="OpenFirefoxAddonPage_Click"
                       Margin="0,0,0,4"
                       ToolTip="Opens the official Mozilla Add-ons page — one click to install" />
            <TextBlock Text="Install permanently from Firefox Add-ons with one click."
                       FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,24" />

            <!-- Section 3: More Help -->
            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <DockPanel LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Click="OpenMoreHelp_Click" Height="32" Padding="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="More Help" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="↗" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Why is manual setup required?" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Illustrated guide: browser security sandboxes and step-by-step setup." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
