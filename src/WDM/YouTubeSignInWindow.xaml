<ui:FluentWindow x:Class="WDM.YouTubeSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WDM — Sign in with YouTube"
        Icon="Assets/WDM.ico"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource Brush.Bg}"
        ShowInTaskbar="False">

    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Hint -->
            <RowDefinition Height="*" />    <!-- Browser Host -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sign in with YouTube">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Hint -->
        <Border Grid.Row="1" Padding="14,10"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Sign in with your Google account"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextWrapping="Wrap"
                           Text="This window is only used once — your session is saved as a local cookies file and refreshed automatically. Private, age-restricted and bot-checked videos will work." />
            </StackPanel>
        </Border>

        <!-- Browser Host -->
        <Border Grid.Row="2" Margin="12,12,12,8"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid x:Name="WebViewContainer" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource Button.SecondaryAction}"
                               Content="Reload YouTube"
                               Height="32"
                               Click="Reload_Click"
                               Margin="0,0,10,0" />
                    <ui:Button Style="{StaticResource Button.SecondaryAction}"
                               Content="Cancel"
                               IsCancel="True"
                               Click="Cancel_Click"
                               Height="32"
                               MinWidth="90"
                               Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource Button.PrimaryAction}"
                               Content="Use this browser session"
                               Height="32"
                               MinWidth="150"
                               ToolTip="Save the cookies of the Google account you signed into above"
                               Click="UseSession_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
