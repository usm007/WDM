<Window x:Class="WDM.YouTubeSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WDM — Sign in with YouTube"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hint -->
        <Border Grid.Row="0" Padding="14,10"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Sign in with your Google account"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextWrapping="Wrap"
                           Text="This window is only used once — your session is saved as a local cookies file and refreshed automatically. Private, age-restricted and bot-checked videos will work." />
            </StackPanel>
        </Border>

        <!-- Browser Host -->
        <Border Grid.Row="1" Margin="12,12,12,8"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid x:Name="WebViewContainer" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextDim}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Reload YouTube"
                            Height="32"
                            Click="Reload_Click"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Cancel"
                            IsCancel="True"
                            Click="Cancel_Click"
                            Height="32"
                            MinWidth="90"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Accent}"
                            Content="Use this browser session"
                            Height="32"
                            MinWidth="150"
                            ToolTip="Save the cookies of the Google account you signed into above"
                            Click="UseSession_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
