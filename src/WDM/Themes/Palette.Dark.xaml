<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ DARK PALETTE — Windows 11 Deliberate Dark Desktop Theme ============ -->
    <!-- Surfaces & Neutrals Hierarchy (Low Visual Fatigue) -->
    <Color x:Key="Color.Bg">#202020</Color>           <!-- Level 0: Shell background / Title bar -->
    <Color x:Key="Color.Sidebar">#1E1E1E</Color>      <!-- Level 0: Navigation rail (distinct dark tone) -->
    <Color x:Key="Color.CommandBar">#252525</Color>   <!-- Level 0: Top command bar (solid dark grey tone) -->
    <Color x:Key="Color.Surface">#272727</Color>      <!-- Level 1: Primary content canvas / Download list -->
    <Color x:Key="Color.SurfaceAlt">#2C2C2C</Color>   <!-- Level 2: Elevated inspector / Footers / Dialog cards -->
    <Color x:Key="Color.SurfaceHover">#333333</Color> <!-- Level 3: Interactive hover state -->
    <Color x:Key="Color.Border">#2E2E2E</Color>       <!-- Level 1: Restrained 1px subtle divider -->
    <Color x:Key="Color.BorderStrong">#3E3E3E</Color> <!-- Level 2: Interactive border -->
    <Color x:Key="Color.GridLine">#282828</Color>     <!-- Table gridlines -->
    <Color x:Key="Color.RowAlt">#242424</Color>       <!-- Alternating grid rows -->

    <!-- Text Hierarchy (Glare-Free, High Legibility) -->
    <Color x:Key="Color.Text">#F3F3F3</Color>         <!-- Primary crisp white text -->
    <Color x:Key="Color.TextDim">#C5C5C5</Color>      <!-- Subtitle and secondary technical text -->
    <Color x:Key="Color.TextMuted">#8A8A8A</Color>    <!-- Quiet captions, labels, metadata -->

    <!-- Accent — Windows 11 Blue (Restrained, No Neon Glare) -->
    <Color x:Key="Color.Accent">#4CC2FF</Color>
    <Color x:Key="Color.AccentHover">#60CDFF</Color>
    <Color x:Key="Color.AccentActive">#3BB5F5</Color>
    <Color x:Key="Color.AccentDark">#0078D4</Color>
    <Color x:Key="Color.AccentSoft">#162E44</Color>
    <Color x:Key="Color.AccentSoftStrong">#1E3F5F</Color>
    <Color x:Key="Color.AccentText">#FFFFFF</Color>

    <!-- Semantic Status Colors (Restrained, Non-Glowing) -->
    <Color x:Key="Color.StatusActive">#4CC2FF</Color>   <!-- Active / Downloading -->
    <Color x:Key="Color.StatusComplete">#6CCB5F</Color> <!-- Completed -->
    <Color x:Key="Color.StatusFailed">#FF99A4</Color>   <!-- Failed / Error -->
    <Color x:Key="Color.StatusPaused">#9E9E9E</Color>   <!-- Paused / Idle -->
    <Color x:Key="Color.StatusQueued">#FCE100</Color>   <!-- Queued / Waiting -->

    <Color x:Key="Color.StatusActiveSoft">#162E44</Color>
    <Color x:Key="Color.StatusCompleteSoft">#142B1B</Color>
    <Color x:Key="Color.StatusFailedSoft">#38181B</Color>
    <Color x:Key="Color.StatusPausedSoft">#252525</Color>
    <Color x:Key="Color.StatusQueuedSoft">#302A08</Color>

    <!-- Generic Semantics -->
    <Color x:Key="Color.Success">#6CCB5F</Color>
    <Color x:Key="Color.Warning">#FCE100</Color>
    <Color x:Key="Color.Danger">#FF99A4</Color>
    <Color x:Key="Color.Failed">#FF99A4</Color>

    <!-- Disabled State -->
    <Color x:Key="Color.DisabledBg">#1D1D1D</Color>
    <Color x:Key="Color.DisabledFg">#606060</Color>

    <!-- Interactive Row States -->
    <Color x:Key="Color.Track">#2A2A2A</Color>
    <Color x:Key="Color.RowHover">#282828</Color>
    <Color x:Key="Color.RowSelected">#162C40</Color> <!-- Restrained Windows 11 blue selection -->

    <!-- Category Accent Tints -->
    <Color x:Key="Color.CatCompressed">#94A3B8</Color>
    <Color x:Key="Color.CatDocument">#34D399</Color>
    <Color x:Key="Color.CatMusic">#FB923C</Color>
    <Color x:Key="Color.CatProgram">#A78BFA</Color>
    <Color x:Key="Color.CatVideo">#60A5FA</Color>

    <!-- Required Explicit Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="FailedBrush" Color="{StaticResource Color.Failed}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource Color.RowAlt}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="AccentBlueBgBrush" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource Color.StatusComplete}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource Color.StatusCompleteSoft}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource Color.StatusQueued}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource Color.StatusQueuedSoft}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource Color.StatusFailed}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource Color.StatusFailedSoft}" />

    <!-- Standard Framework Brushes -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="{StaticResource Color.GridLine}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <!-- Solid Backgrounds for CommandBar and TitleBar -->
    <SolidColorBrush x:Key="Brush.CommandBarBg" Color="{StaticResource Color.CommandBar}" />
    <SolidColorBrush x:Key="Brush.TitleBarBg" Color="{StaticResource Color.CommandBar}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentActive" Color="{StaticResource Color.AccentActive}" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="{StaticResource Color.AccentSoftStrong}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />

    <SolidColorBrush x:Key="Brush.StatusActive" Color="{StaticResource Color.StatusActive}" />
    <SolidColorBrush x:Key="Brush.StatusComplete" Color="{StaticResource Color.StatusComplete}" />
    <SolidColorBrush x:Key="Brush.StatusFailed" Color="{StaticResource Color.StatusFailed}" />
    <SolidColorBrush x:Key="Brush.StatusPaused" Color="{StaticResource Color.StatusPaused}" />
    <SolidColorBrush x:Key="Brush.StatusQueued" Color="{StaticResource Color.StatusQueued}" />

    <SolidColorBrush x:Key="Brush.StatusActiveSoft" Color="{StaticResource Color.StatusActiveSoft}" />
    <SolidColorBrush x:Key="Brush.StatusCompleteSoft" Color="{StaticResource Color.StatusCompleteSoft}" />
    <SolidColorBrush x:Key="Brush.StatusFailedSoft" Color="{StaticResource Color.StatusFailedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusPausedSoft" Color="{StaticResource Color.StatusPausedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusQueuedSoft" Color="{StaticResource Color.StatusQueuedSoft}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.StatusComplete}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.StatusQueued}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.StatusFailed}" />

    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{StaticResource Color.DisabledBg}" />
    <SolidColorBrush x:Key="Brush.DisabledFg" Color="{StaticResource Color.DisabledFg}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="{StaticResource Color.RowAlt}" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="{StaticResource Color.RowSelected}" />

    <!-- Checkbox tokens -->
    <SolidColorBrush x:Key="Brush.CheckboxBg" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.CheckboxCheckedBg" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.CheckboxCheckedFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CheckboxCheckedBorder" Color="{StaticResource Color.Accent}" />

    <!-- Category Brushes -->
    <SolidColorBrush x:Key="Brush.CatCompressed" Color="{StaticResource Color.CatCompressed}" />
    <SolidColorBrush x:Key="Brush.CatDocument" Color="{StaticResource Color.CatDocument}" />
    <SolidColorBrush x:Key="Brush.CatMusic" Color="{StaticResource Color.CatMusic}" />
    <SolidColorBrush x:Key="Brush.CatProgram" Color="{StaticResource Color.CatProgram}" />
    <SolidColorBrush x:Key="Brush.CatVideo" Color="{StaticResource Color.CatVideo}" />
</ResourceDictionary>
