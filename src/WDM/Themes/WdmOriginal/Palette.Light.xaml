<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ LIGHT PALETTE — Windows 11 Fluent Light + Electric Blue CTA Accent ============ -->
    <!-- Neutral tokens -->
    <Color x:Key="Color.Bg">#F4F7FB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F8FAFD</Color>
    <Color x:Key="Color.SurfaceHover">#EEF2F8</Color>
    <Color x:Key="Color.Border">#E3E8F0</Color>
    <Color x:Key="Color.BorderStrong">#CBD5E1</Color>
    <Color x:Key="Color.GridLine">#E9EDF4</Color>
    <Color x:Key="Color.Text">#0F172A</Color>
    <Color x:Key="Color.TextDim">#64748B</Color>
    <Color x:Key="Color.TextMuted">#94A3B8</Color>

    <!-- Accent — electric primary blue -->
    <Color x:Key="Color.Accent">#1865F2</Color>
    <Color x:Key="Color.AccentDark">#0C52D9</Color>
    <Color x:Key="Color.AccentSoft">#E4EEFF</Color>
    <Color x:Key="Color.AccentSoftStrong">#CCE0FF</Color>

    <!-- AccentFg — foreground on accent-coloured surfaces -->
    <Color x:Key="Color.AccentFg">#FFFFFF</Color>

    <!-- Primary CTA Gradient Colors (Light Mode: Electric Blue) -->
    <Color x:Key="Color.CtaGradientStart">#1A6AFE</Color>
    <Color x:Key="Color.CtaGradientEnd">#0B52D9</Color>

    <!-- Active Sidebar Selection Capsule Pill Gradient -->
    <Color x:Key="Color.SidebarSelectedStart">#E4EEFF</Color>
    <Color x:Key="Color.SidebarSelectedEnd">#D9E8FF</Color>
    <Color x:Key="Color.SidebarSelectedText">#1865F2</Color>

    <!-- Semantic status colors -->
    <Color x:Key="Color.StatusActive">#1865F2</Color>
    <Color x:Key="Color.StatusComplete">#16A34A</Color>
    <Color x:Key="Color.StatusFailed">#EF4444</Color>
    <Color x:Key="Color.StatusPaused">#F59E0B</Color>
    <Color x:Key="Color.StatusQueued">#7C3AED</Color>

    <!-- Soft tints for status elements -->
    <Color x:Key="Color.StatusActiveSoft">#FCFDFF</Color>
    <Color x:Key="Color.StatusCompleteSoft">#E7F6ED</Color>
    <Color x:Key="Color.StatusFailedSoft">#FDECEC</Color>
    <Color x:Key="Color.StatusPausedSoft">#FEF5E6</Color>
    <Color x:Key="Color.StatusQueuedSoft">#F2EBFD</Color>

    <!-- Semantic aliases -->
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>

    <!-- Disabled state -->
    <Color x:Key="Color.DisabledBg">#F1F4F8</Color>
    <Color x:Key="Color.DisabledFg">#A8B1BD</Color>

    <!-- Zones -->
    <Color x:Key="Color.Track">#E6EBF2</Color>
    <Color x:Key="Color.Sidebar">#FFFFFF</Color>
    <Color x:Key="Color.RowAlt">#FBFCFE</Color>
    <Color x:Key="Color.RowHover">#F4F7FC</Color>
    <Color x:Key="Color.RowSelected">#EAF3FF</Color>

    <!-- Per-category icon tints -->
    <Color x:Key="Color.CatAll">#1865F2</Color>
    <Color x:Key="Color.CatCompressed">#D97706</Color>
    <Color x:Key="Color.CatDocument">#2563EB</Color>
    <Color x:Key="Color.CatMusic">#10B981</Color>
    <Color x:Key="Color.CatProgram">#2563EB</Color>
    <Color x:Key="Color.CatVideo">#9333EA</Color>

    <!-- Sidebar promo card gradient -->
    <Color x:Key="Color.PromoStart">#FFFFFF</Color>
    <Color x:Key="Color.PromoEnd">#EAF3FF</Color>

    <!-- Palette Brushes -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="{StaticResource Color.GridLine}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="{StaticResource Color.AccentSoftStrong}" />
    <SolidColorBrush x:Key="Brush.AccentFg"         Color="{StaticResource Color.AccentFg}" />

    <LinearGradientBrush x:Key="Brush.CtaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.CtaGradientStart}" />
        <GradientStop Offset="1" Color="{StaticResource Color.CtaGradientEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SidebarSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color.SidebarSelectedStart}" />
        <GradientStop Offset="1" Color="{StaticResource Color.SidebarSelectedEnd}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarSelectedText" Color="{StaticResource Color.SidebarSelectedText}" />

    <SolidColorBrush x:Key="Brush.StatusActive" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.StatusComplete" Color="{StaticResource Color.StatusComplete}" />
    <SolidColorBrush x:Key="Brush.StatusFailed" Color="{StaticResource Color.StatusFailed}" />
    <SolidColorBrush x:Key="Brush.StatusPaused" Color="{StaticResource Color.StatusPaused}" />
    <SolidColorBrush x:Key="Brush.StatusQueued" Color="{StaticResource Color.StatusQueued}" />
    <SolidColorBrush x:Key="Brush.StatusActiveSoft" Color="{StaticResource Color.StatusActiveSoft}" />
    <SolidColorBrush x:Key="Brush.StatusCompleteSoft" Color="{StaticResource Color.StatusCompleteSoft}" />
    <SolidColorBrush x:Key="Brush.StatusFailedSoft" Color="{StaticResource Color.StatusFailedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusPausedSoft" Color="{StaticResource Color.StatusPausedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusQueuedSoft" Color="{StaticResource Color.StatusQueuedSoft}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{StaticResource Color.DisabledBg}" />
    <SolidColorBrush x:Key="Brush.DisabledFg" Color="{StaticResource Color.DisabledFg}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="{StaticResource Color.RowAlt}" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="{StaticResource Color.RowSelected}" />

    <SolidColorBrush x:Key="Brush.CatAll" Color="{StaticResource Color.CatAll}" />
    <SolidColorBrush x:Key="Brush.CatCompressed" Color="{StaticResource Color.CatCompressed}" />
    <SolidColorBrush x:Key="Brush.CatDocument" Color="{StaticResource Color.CatDocument}" />
    <SolidColorBrush x:Key="Brush.CatMusic" Color="{StaticResource Color.CatMusic}" />
    <SolidColorBrush x:Key="Brush.CatProgram" Color="{StaticResource Color.CatProgram}" />
    <SolidColorBrush x:Key="Brush.CatVideo" Color="{StaticResource Color.CatVideo}" />
    <SolidColorBrush x:Key="Brush.PromoStart" Color="{StaticResource Color.PromoStart}" />
    <SolidColorBrush x:Key="Brush.PromoEnd" Color="{StaticResource Color.PromoEnd}" />

    <!-- Shadow effects -->
    <DropShadowEffect x:Key="Shadow.Button"       BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#1865F2" />
    <DropShadowEffect x:Key="Shadow.ButtonStrong" BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#1865F2" />
    <DropShadowEffect x:Key="Shadow.Input"        BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#1B2737" />
    <DropShadowEffect x:Key="Shadow.InputFocus"   BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#1677E8" />
    <DropShadowEffect x:Key="Shadow.Card"         BlurRadius="16" ShadowDepth="2" Opacity="0.09" Color="#1B2737" />
    <DropShadowEffect x:Key="Shadow.CardDialog"   BlurRadius="20" ShadowDepth="3" Opacity="0.12" Color="#1B2737" />
    <DropShadowEffect x:Key="Shadow.Popup"        BlurRadius="18" ShadowDepth="3" Opacity="0.10" Color="#1B2737" />
    <DropShadowEffect x:Key="Shadow.ToolbarPill"  BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="#1B2737" />
    <DropShadowEffect x:Key="Shadow.Logo"         BlurRadius="8"  ShadowDepth="1" Opacity="0.12" Color="#1865F2" />

</ResourceDictionary>