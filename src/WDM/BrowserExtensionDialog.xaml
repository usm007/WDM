<Window x:Class="WDM.BrowserExtensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable Browser Extension — WDM"
        Icon="Assets/WDM.ico"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource Font.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Enable Browser Integration" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="Catch downloads automatically from Google Chrome, Edge, and Firefox." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" x:Name="StatusCard" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <DockPanel>
                <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.Warning}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitleText" Text="Waiting for extension..." FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Warning}" />
                    <TextBlock x:Name="StatusSubText" Text="WDM local server listening on http://127.0.0.1:17530" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1-Click Quick Actions Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!-- Row 0: Chrome/Edge install now & Firefox automatic -->
            <Button Grid.Row="0" Grid.Column="0" Content="▶ Install Now (Chrome/Edge)" Style="{StaticResource Button.Accent}" Click="LaunchChrome_Click" Margin="0,0,4,6" Height="30" Padding="10,0" />
            <Button Grid.Row="0" Grid.Column="1" Content="🦊 Install Firefox (Automatic)" Style="{StaticResource Button.Secondary}" Click="InstallFirefox_Click" Margin="4,0,0,6" Height="30" Padding="10,0" />

            <!-- Row 1: Permanent store install & copy path -->
            <Button Grid.Row="1" Grid.Column="0" Content="🔒 Permanent Install (Store)" Style="{StaticResource Button.Secondary}" Click="PreinstallChrome_Click" Margin="0,0,4,0" Height="30" Padding="10,0" />
            <Button Grid.Row="1" Grid.Column="1" x:Name="CopyPathButton" Content="📋 Copy Extension Path" Style="{StaticResource Button.Secondary}" Click="CopyPath_Click" Margin="4,0,0,0" Height="30" Padding="10,0" />
        </Grid>

        <!-- Manual Fallback -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="If automatic install fails — manual option:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />
                <TextBlock Text="Chrome/Edge: click “Copy Extension Path”, then open chrome://extensions, enable Developer mode, click “Load unpacked” and paste that folder. Firefox: open about:debugging#/runtime/this-firefox and click “Load Temporary Add-on” (session only)." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
            </StackPanel>
        </Border>

        <!-- Step-by-Step Instructions Card -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="How to install:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                    <TextBlock Text="🦊" Margin="0,0,8,0" />
                    <TextBlock x:Name="FirefoxStatusText" Text="Firefox: click “Install Firefox (Automatic)” — WDM registers it so Firefox installs it on next launch." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBlock Text="🌐" Margin="0,0,8,0" />
                    <TextBlock x:Name="ChromiumStatusText" Text="Chrome/Edge: “Install Now” loads the extension right away (session only). For a permanent install, publish the add-on once to the store, then use “Permanent Install (Store)” and confirm the one-time prompt." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <TextBlock Text="📦" Margin="0,0,8,0" />
                    <TextBlock Text="Store publishing: Chrome Web Store charges a one-time $5 developer fee; Microsoft Edge Add-ons is free. No store ID set yet — permanent install activates once the ID is added." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="5" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14" />

        <!-- Bottom Action -->
        <DockPanel Grid.Row="6" LastChildFill="False">
            <TextBlock x:Name="FeedbackText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="Done" Style="{StaticResource Button.Accent}" IsCancel="True" Click="CloseClick" MinWidth="100" Height="30" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
