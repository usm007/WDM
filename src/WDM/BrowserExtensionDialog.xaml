<Window x:Class="WDM.BrowserExtensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Browser Extension — WDM"
        Icon="Assets/WDM.ico"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="24,20,24,20">
        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0431;" FontFamily="{StaticResource Font.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Install the WDM Extension" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Catch downloads automatically from Chrome, Edge, or Firefox." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Chrome / Edge / Chromium -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Chrome, Edge &amp; other Chromium browsers" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <Button x:Name="CopyPathButton" Content="Copy Extension Path" Style="{StaticResource Button.Secondary}" Click="CopyPath_Click" Height="30" Padding="14,0" />
                        <Button Content="Open Extensions Page" Style="{StaticResource Button.Secondary}" Click="OpenExtensions_Click" Height="30" Padding="14,0" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="1.  Click “Copy Extension Path”." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="2.  Click “Open Extensions Page” (chrome://extensions or edge://extensions)." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="3.  Turn on “Developer mode” (switch in the top-right corner)." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="4.  Click “Load unpacked”." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="5.  Select the extension folder you copied and click “Select Folder”." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>

            <!-- Firefox -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Firefox" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />

                    <TextBlock Text="Recommended — install from the Firefox Add-ons store (permanent):" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Open Firefox Add-ons page" Style="{StaticResource Button.Accent}" Click="OpenFirefoxAddonPage_Click" Height="30" Padding="14,0" />
                    </StackPanel>

                    <TextBlock Text="Temporary option — load it manually (session only):" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource Brush.Text}" Margin="0,6,0,4" />
                    <TextBlock Text="1.  Open about:debugging#/runtime/this-firefox in Firefox." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="2.  Click “Load Temporary Add-on”." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                    <TextBlock Text="3.  Select the manifest.json file inside the extension folder." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>

            <!-- Bottom Action -->
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="FeedbackText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Done" Style="{StaticResource Button.Accent}" IsCancel="True" Click="CloseClick" MinWidth="100" Height="30" DockPanel.Dock="Right" />
            </DockPanel>

        </StackPanel>
    </Grid>
</Window>