<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\WDM.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.5.3.0</Version>
    <AssemblyTitle>WDM</AssemblyTitle>
    <Product>WDM</Product>
    <FileDescription>WDM — fast, multi-threaded download manager for Windows</FileDescription>
    <Company>WDM Team</Company>
    <Copyright>Copyright © WDM Team</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\WDM.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Fonts\materialdesignicons-webfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\WDM.BrowserExtension\**\*" Exclude="..\WDM.BrowserExtension\**\*.md">
      <Link>BrowserExtension\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WdmOriginalMainWindow.xaml.cs" />
    <Page Remove="WdmOriginalMainWindow.xaml" />
    <Page Remove="Themes\WdmOriginal\**\*" />
    <None Remove="Themes\WdmOriginal\**\*" />
  </ItemGroup>

</Project>
