<Window x:Class="WDM.PageResourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Page Resources — WDM"
        AutomationProperties.AutomationId="PageResourcesDialogWindow"
        Icon="Assets/WDM.ico"
        Width="700"
        Height="480"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="16,14,16,8" LastChildFill="True">
                <Button Style="{StaticResource Button.DialogClose}" Click="CloseClick"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Page Resources" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Media detected across browser tabs" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1.5,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Toolbar -->
            <Border Grid.Row="0" DockPanel.Dock="Top" Margin="0,0,0,6">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="DownloadSelectedButton" Content="Download" Appearance="Primary"
                                   Click="DownloadSelected_Click" Padding="12,0" Height="28" FontSize="12"
                                   IsEnabled="False" ToolTip="Download selected resources"
                                   AutomationProperties.AutomationId="BtnDownloadSelected" />
                        <ui:Button x:Name="BlockDomainButton" Content="Block domain" Appearance="Secondary"
                                   Click="BlockDomain_Click" Padding="12,0" Height="28" FontSize="12"
                                   IsEnabled="False" Margin="6,0,0,0" ToolTip="Block all resources from this domain"
                                   AutomationProperties.AutomationId="BtnBlockDomain" />
                        <ui:Button x:Name="BlockUrlButton" Content="Block URL" Appearance="Secondary"
                                   Click="BlockUrl_Click" Padding="12,0" Height="28" FontSize="12"
                                   IsEnabled="False" Margin="6,0,0,0" ToolTip="Block this specific URL"
                                   AutomationProperties.AutomationId="BtnBlockUrl" />
                    </StackPanel>
                    <ui:TextBox x:Name="SearchBox" Width="200" PlaceholderText="Filter..."
                                ClearButtonEnabled="True" TextChanged="SearchBox_TextChanged"
                                VerticalContentAlignment="Center" Padding="6,0" Height="28" FontSize="12"
                                AutomationProperties.AutomationId="SearchBox" />
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      x:Name="ResourcesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      SelectionChanged="ResourcesGrid_SelectionChanged"
                      AutomationProperties.AutomationId="ResourcesGrid"
                      AutomationProperties.Name="Page resources list">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
                    <DataGridTextColumn Header="Tab" Binding="{Binding TabTitle}" Width="120" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceUrl}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom status -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="12,6">
                <DockPanel>
                    <TextBlock x:Name="StatusText" Text="Loading..." FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.DialogClose}" Click="CloseClick"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
