<Window x:Class="WDM.TaskPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Properties — WDM"
        Icon="Assets/WDM.ico"
        Width="540"
        Height="540"
        MinHeight="460"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Content Body -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
        </Grid.RowDefinitions>

        <!-- Main Body -->
        <Grid Grid.Row="0" Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Scrollable Properties Grid -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Download properties" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,2" />
                    <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </DockPanel>

            <!-- Properties Body in ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- URL -->
                        <RowDefinition Height="Auto" /> <!-- Save Folder -->
                        <RowDefinition Height="Auto" /> <!-- Size -->
                        <RowDefinition Height="Auto" /> <!-- Progress -->
                        <RowDefinition Height="Auto" /> <!-- Speed -->
                        <RowDefinition Height="Auto" /> <!-- Connections -->
                        <RowDefinition Height="Auto" /> <!-- Resume -->
                        <RowDefinition Height="Auto" /> <!-- Added -->
                        <RowDefinition Height="Auto" /> <!-- Category -->
                        <RowDefinition Height="Auto" /> <!-- Priority -->
                        <RowDefinition Height="Auto" /> <!-- Headers -->
                        <RowDefinition Height="Auto" /> <!-- Checksum -->
                    </Grid.RowDefinitions>

                    <!-- URL -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source URL" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="UrlText" Grid.Row="0" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}" Margin="0,5" />

                    <!-- Save Folder -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Save location" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="FolderText" Grid.Row="1" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,5" />

                    <!-- Size -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total size" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" FontSize="13" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" Margin="0,5" />

                    <!-- Progress -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Progress" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5">
                        <ProgressBar x:Name="ProgressBar" Style="{StaticResource ProgressBar.Thin}" Height="3" Maximum="100" />
                        <TextBlock x:Name="PercentText" FontSize="12" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Speed -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Throughput" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="SpeedText" Grid.Row="4" Grid.Column="1" FontSize="13" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Margin="0,5" />

                    <!-- Connections -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Connections" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="ChunksText" Grid.Row="5" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />

                    <!-- Resume -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Server range" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="ResumeCapText" Grid.Row="6" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />

                    <!-- Added Date -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Added date" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="AddedText" Grid.Row="7" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />

                    <!-- Category -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Category" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="CategoryText" Grid.Row="8" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />

                    <!-- Priority -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Priority" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="PriorityText" Grid.Row="9" Grid.Column="1" FontSize="12.5" FontWeight="Medium" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" Margin="0,5" />

                    <!-- Custom Headers -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Custom headers" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="HeadersText" Grid.Row="10" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />

                    <!-- Checksum -->
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="SHA-256 hash" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5" />
                    <TextBlock x:Name="ChecksumText" Grid.Row="11" Grid.Column="1" FontSize="12.5" FontFamily="{StaticResource Font.App}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Action Strip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button Content="Copy URL" Style="{StaticResource Button.Secondary}" Click="CopyUrlClick" Height="28" Padding="12,0" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Open Folder" Style="{StaticResource Button.Secondary}" Click="FolderClick" Height="28" Padding="12,0" Margin="0,0,8,0" />
                    <Button Content="Close" Style="{StaticResource Button.Accent}" IsCancel="True" IsDefault="True" Click="CloseClick" MinWidth="85" Height="28" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
