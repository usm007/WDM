<Window x:Class="WDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WDM"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="Windows Download Manager"
        Icon="Assets/WDM.ico"
        Width="792"
        Height="490"
        MinWidth="650"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <vm:TaskStatusToColorConverter x:Key="StatusColor" />
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:StatusToBrushConverter x:Key="StatusToBrush" />
        <vm:StatusToIconConverter x:Key="StatusToIcon" />
        <vm:EmptyDashConverter x:Key="EmptyDash" />
        <vm:TextToVisibilityConverter x:Key="TextToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:RetryVisibilityConverter x:Key="RetryVis" />
        <vm:NullToVisibilityConverter x:Key="NullToVis" />
        <vm:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sidebar action link button (e.g. Browser Integration) -->
        <Style x:Key="SidebarLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenAddDialogCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OptionsCommand}" />
        <KeyBinding Key="Delete" Command="{Binding BulkRemoveCommand}" />
        <KeyBinding Key="Enter" Command="{Binding BulkResumeCommand}" />
        <KeyBinding Key="Return" Command="{Binding BulkResumeCommand}" />
        <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Key="F5" Command="{Binding RetryCommand}" />
    </Window.InputBindings>

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Top Action Command Bar Strip -->
            <RowDefinition Height="1" />    <!-- 1. 1px Subtle Separator -->
            <RowDefinition Height="*" />    <!-- 2. Main Workspace: Sidebar + Separator + Download Grid + Detail Pane -->
            <RowDefinition Height="Auto" /> <!-- 3. Bottom Status Bar Strip -->
        </Grid.RowDefinitions>

        <!-- 1. Top Command Bar Strip (Deeper Gradient Surface) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.CommandBarBg}" Padding="10,5,10,5">
            <DockPanel LastChildFill="True">
                <!-- Right Action / Utility Area -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input Box with Filter Funnel -->
                    <Border Width="180" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Width="Auto" Height="28" Background="Transparent" BorderThickness="0" Padding="8,0,4,0" FontSize="12"
                                     VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     CaretBrush="{DynamicResource Brush.Accent}"
                                     ToolTip="Search downloads (Ctrl+F)">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <TextBlock Text="Search downloads…" FontSize="12" Margin="8,0"
                                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                       Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- Clear Search text button (when searching) -->
                            <Button Grid.Column="1" Style="{StaticResource Button.RowAction}" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" Width="18" Height="18" ToolTip="Clear search" Margin="1,0">
                                <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Button>

                            <!-- Filter Funnel Icon Button -->
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" Margin="0,0,3,0" ToolTip="Filter downloads">
                                <TextBlock Text="&#xF0232;" FontFamily="{StaticResource Font.Icon}" FontSize="13.5"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Utility Controls: Settings, Theme, About -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding OptionsCommand}" ToolTip="Settings (Ctrl+,)">
                        <TextBlock Text="&#xF08BB;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{DynamicResource Brush.TextDim}" />
                    </Button>

                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeButtonToolTip}">
                        <TextBlock Text="{Binding ThemeButtonIcon}" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{DynamicResource Brush.TextDim}" />
                    </Button>

                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding AboutCommand}" ToolTip="About Windows Download Manager">
                        <TextBlock Text="&#xF02FD;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
                    </Button>
                </StackPanel>

                <!-- Left Action Controls: + Add Download & Stacked Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- + Add Download (Outlined Button with Blue Icon & Text) -->
                    <Button Style="{StaticResource Button.AddDownloadPrimary}" Command="{Binding OpenAddDialogCommand}" ToolTip="Add Download (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Download" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Vertical Separator Line 1 -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Brush.Border}" Margin="8,0,6,0" VerticalAlignment="Center" />

                    <!-- Action 1: Resume -->
                    <Button Style="{StaticResource Button.ToolbarVertical}" Command="{Binding BulkResumeCommand}" ToolTip="Resume download(s) (Enter)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xF040A;" FontFamily="{StaticResource Font.Icon}" FontSize="16.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Resume" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,1.5,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>

                    <!-- Action 2: Pause -->
                    <Button Style="{StaticResource Button.ToolbarVertical}" Command="{Binding BulkPauseCommand}" ToolTip="Pause download(s) (Space)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xF03E4;" FontFamily="{StaticResource Font.Icon}" FontSize="16.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Pause" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,1.5,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>

                    <!-- Action 3: Stop All -->
                    <Button Style="{StaticResource Button.ToolbarVertical}" Command="{Binding PauseAllCommand}" ToolTip="Stop all active downloads">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xF04DB;" FontFamily="{StaticResource Font.Icon}" FontSize="16.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Stop All" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,1.5,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>

                    <!-- Vertical Separator Line 2 -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Brush.Border}" Margin="6,0,6,0" VerticalAlignment="Center" />

                    <!-- Action 4: Delete -->
                    <Button Style="{StaticResource Button.ToolbarVertical}" Command="{Binding BulkRemoveCommand}" ToolTip="Delete selected download(s) (Del)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="16.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Delete" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,1.5,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>

                    <!-- Action 5: Clear (Eraser Icon) -->
                    <Button Style="{StaticResource Button.ToolbarVertical}" Command="{Binding ClearCompletedCommand}" ToolTip="Clear finished downloads">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xF00E2;" FontFamily="{StaticResource Font.Icon}" FontSize="16.5" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Clear" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,1.5,0,0" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Ribbon Divider Line -->
        <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

        <!-- 3. Main Workspace (Categories Tree Sidebar + Vertical Divider + Download Grid + Detail Pane) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="118" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Categories & Views) -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="4,4,4,6">
                <!-- Navigation Categories and Views List -->
                <ListBox ItemsSource="{Binding Filters}"
                         SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                         SelectedValuePath="Kind"
                         Style="{StaticResource ListBox.Sidebar}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Section Header Label (Uppercase, e.g. CATEGORIES, VIEWS) -->
                                <TextBlock Grid.ColumnSpan="2" Text="{Binding HeaderText}"
                                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="3,5,0,2" VerticalAlignment="Center"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />

                                <!-- Section Divider -->
                                <Border Grid.ColumnSpan="2" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,3" VerticalAlignment="Center" Opacity="0.3"
                                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />

                                <!-- Item Icon -->
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                           Foreground="{Binding CategoryBrush}" Margin="2,0,5,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Item Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="None">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Vertical Divider Line between Sidebar and Main Area -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

            <!-- Main Content Area: Switches between Downloads, Settings, Extensions -->
            <Grid Grid.Column="2" Background="{DynamicResource Brush.Surface}">
                
                <!-- VIEW 1: Downloads View (Table Grid + Detail Pane) -->
                <Grid x:Name="DownloadsView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" /> <!-- Header Row -->
                        <RowDefinition Height="*" />  <!-- DataGrid Content -->
                    </Grid.RowDefinitions>

                    <!-- Table Header Strip -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,0" Height="26">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="File Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Size" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="ETA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Downloads DataGrid List -->
                    <DataGrid Grid.Row="1"
                              x:Name="TaskGrid"
                              ItemsSource="{Binding TasksView}"
                              SelectedItem="{Binding SelectedTask}"
                              SelectionChanged="TaskGrid_SelectionChanged"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              RowHeight="44"
                              HeadersVisibility="None"
                              SelectionMode="Extended"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MouseDoubleClick="TaskGrid_MouseDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="A" Modifiers="Control" Command="SelectAll" />
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open" Command="{Binding OpenFileCommand}" FontWeight="Bold">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF03CB;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open folder" Command="{Binding RevealCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0770;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Resume" Command="{Binding ResumeCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF040A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Pause" Command="{Binding PauseCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF03E4;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Restart" Command="{Binding RetryCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0709;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Stop" Command="{Binding StopCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF04DB;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Refresh link..." Command="{Binding RefreshLinkCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0339;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Clean / format video name" Command="{Binding CleanFileNameCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF059F;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Bypass Cloudflare / protection..." Command="{Binding SolveCloudflareCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0026;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF018F;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Priority">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0603;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
                                    <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                                    <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                                </MenuItem>
                                <MenuItem Header="Move up" Command="{Binding MoveUpCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF005D;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move down" Command="{Binding MoveDownCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0045;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF11E8;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete" Command="{Binding RemoveCommand}" InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.StatusFailed}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete with file" Command="{Binding RemoveWithFileCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.StatusFailed}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,0,12,0" Height="44" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: File Type Icon -->
                                                <ColumnDefinition Width="26" />
                                                <!-- Col 1: File Name -->
                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                <!-- Col 2: Status Column -->
                                                <ColumnDefinition Width="80" />
                                                <!-- Col 3: Size Column -->
                                                <ColumnDefinition Width="75" />
                                                <!-- Col 4: ETA Column -->
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: File Type Icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontFamily="{StaticResource Font.Icon}" FontSize="14.5"
                                                       Foreground="{Binding CategoryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0" />

                                            <!-- Col 1: File Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayFileName}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayFileName}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Error}" FontSize="9.5" Foreground="{DynamicResource Brush.StatusFailed}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" VerticalAlignment="Center" Margin="0,1.5,0,0"
                                                           Visibility="{Binding HasFailureError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Col 2: Status (Done in green, Downloading, Paused, etc.) -->
                                            <TextBlock Grid.Column="2" Text="{Binding PrimaryStatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Col 3: Size (e.g. 220.3 MB, bold on selected row) -->
                                            <TextBlock Grid.Column="3" Text="{Binding DisplaySizeText}" FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Col 4: ETA (e.g. \-\- or time remaining) -->
                                            <TextBlock Grid.Column="4" Text="{Binding EtaOrDashText}" FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State Overlay (when no downloads match filter) -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                                Visibility="{Binding HasNoVisibleTasks, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xF01DA;" FontFamily="{StaticResource Font.Icon}" FontSize="32"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding EmptyStateSubtitle}" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="11.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Selected Item Details Inspector Panel (Visible when an item is selected) -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                        Padding="14,8,14,10"
                        Visibility="{Binding SelectedTask, Converter={StaticResource NullToVis}}">
                    <Grid DataContext="{Binding SelectedTask}">
                        <Grid.ColumnDefinitions>
                            <!-- Left Info Fields Grid -->
                            <ColumnDefinition Width="*" />
                            <!-- Right Progress Bar Section -->
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Metadata Columns -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Top Row: FILE | LOCATION | SOURCE -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="FILE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DisplayFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayFileName}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="LOCATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SaveFolder}" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}"
                                           TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="{Binding FullPath}"
                                           MouseDown="LocationText_MouseDown" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="SOURCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DomainText}" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}"
                                           TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="{Binding Url}"
                                           MouseDown="SourceText_MouseDown" />
                            </StackPanel>

                            <!-- Bottom Row: STATUS | SIZE | ADDED -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding PrimaryStatusText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="SIZE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DisplaySizeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ADDED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding AddedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right Progress Bar Section -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="PROGRESS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadedOfTotalText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource ProgressBar.DetailsPanel}"
                                         Value="{Binding Progress}" Maximum="100" Height="6"
                                         Background="#DBEAFE" Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Full-Overlay Integrated Views (Settings, Extensions, Reload Notice) - Covers Command Bar & Workspace, leaving Titlebar & Bottom Bar visible -->
        <Grid x:Name="SettingsView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:OptionsControl x:Name="SettingsContent" />
        </Grid>

        <Grid x:Name="ExtensionView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:BrowserExtensionControl x:Name="ExtensionContent" />
        </Grid>

        <Grid x:Name="NoticeView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:ExtensionReloadNoticeControl x:Name="NoticeContent" />
        </Grid>

        <!-- 4. Bottom Status Bar Strip -->
        <Border Grid.Row="3" Height="24" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Right status: Sparkline + Tray Icon + Total Speed -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="SparklineCanvas" Width="55" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="&#xF01DA;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusRightText}" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Left status: e.g. 5 downloads · 5 completed (with 5 completed in green) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusPrefixText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusCompletedText}" Foreground="{DynamicResource Brush.StatusComplete}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
