<Window x:Class="WDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="WDM"
        Icon="Assets/WDM.ico"
        Width="918"
        Height="560"
        MinWidth="760"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <vm:TaskStatusToColorConverter x:Key="StatusColor" />
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:TextToVisibilityConverter x:Key="TextToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:RetryVisibilityConverter x:Key="RetryVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ProgressBar.IDM" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Track}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenAddDialogCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OptionsCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Key="F5" Command="{Binding RetryCommand}" />
    </Window.InputBindings>

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Classic Menu Bar -->
            <RowDefinition Height="Auto" /> <!-- IDM Stacked Action Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Body: Tree Sidebar + Download Grid -->
            <RowDefinition Height="22" />   <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Menu Bar (IDM style: Tasks, File, Downloads, View, Help, Registration) -->
        <Border Grid.Row="0" Background="Transparent" Margin="4,0,4,0" Padding="0" BorderThickness="0">
            <Menu Background="Transparent">
                <MenuItem Header="Tasks" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Add New Download..." Command="{Binding OpenAddDialogCommand}" InputGestureText="Ctrl+N" />
                    <Separator />
                    <MenuItem Header="Pause All" Command="{Binding PauseAllCommand}" />
                    <MenuItem Header="Resume All" Command="{Binding StartQueueCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuExit_Click" InputGestureText="Alt+F4" />
                </MenuItem>

                <MenuItem Header="File" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Show Progress Window..." Command="{Binding ShowProgressDialogCommand}" />
                    <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}" />
                    <Separator />
                    <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" />
                    <MenuItem Header="Open Folder" Command="{Binding RevealCommand}" />
                    <Separator />
                    <MenuItem Header="Delete Selected" Command="{Binding RemoveCommand}" InputGestureText="Del" />
                    <MenuItem Header="Delete All Completed" Command="{Binding ClearCompletedCommand}" />
                </MenuItem>

                <MenuItem Header="Downloads" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Start Queue" Command="{Binding StartQueueCommand}" />
                    <MenuItem Header="Stop Queue" Command="{Binding StopQueueCommand}" />
                    <Separator />
                    <MenuItem Header="Browser Extension Setup..." Click="MenuExtension_Click" />
                    <MenuItem Header="Options..." Command="{Binding OptionsCommand}" InputGestureText="Ctrl+," />
                </MenuItem>

                <MenuItem Header="View" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="Clear Search" Command="{Binding ClearSearchCommand}" />
                </MenuItem>

                <MenuItem Header="Help" Style="{StaticResource MenuItem.Top}">
                    <MenuItem Header="About WDM..." Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. IDM Action Toolbar (Icon on top, Text underneath) â€” flat ribbon like WDM original -->
        <Grid Grid.Row="1" Margin="10,0,10,4">
            <DockPanel LastChildFill="True">
                <!-- Search Box (Right-aligned) -->
                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,4,0" Height="36" MaxWidth="180">
                    <Border Style="{StaticResource ToolbarPillShadow}" />
                    <Border Style="{StaticResource ToolbarPill}">
                        <Grid MinWidth="110" Width="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Width="Auto" Height="28" Background="Transparent" BorderThickness="0" Padding="6,0" FontSize="12"
                                     VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search downloads list">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" Width="16" Height="16" ToolTip="Clear search" Margin="2,0">
                                <TextBlock Text="&#xF0349;" FontFamily="{StaticResource Font.Icon}" FontSize="9" Foreground="{DynamicResource Brush.TextDim}" />
                            </Button>
                            <TextBlock Grid.Column="2" Text="&#xF0236;" FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextDim}" Margin="4,0,6,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Search context indicator (search active inside a category filter) -->
                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0" Height="22">
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="8,2" Visibility="{Binding SearchContextText, Converter={StaticResource TextToVis}}">
                        <TextBlock Text="{Binding SearchContextText}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Stacked Action Toolbar Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand logo -->
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                       VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="Windows Download Manager" />
                    <!-- 1. Add URL -->
                    <Button Style="{StaticResource Button.IDMStacked}" MinWidth="68" Command="{Binding OpenAddDialogCommand}" ToolTip="Add new download URL (Ctrl+N)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF1100;" FontFamily="{StaticResource Font.Icon}" FontSize="18" Foreground="#2E9B57" HorizontalAlignment="Center" Margin="0,0,0,1" />
                            <TextBlock Text="Add URL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 2. Resume -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding ResumeCommand}" ToolTip="Resume selected download (Space)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF040A;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.StatusActive}" />
                            <TextBlock Text="Resume" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 3. Stop -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding PauseCommand}" ToolTip="Stop selected download (Space)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF03E4;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.StatusPaused}" />
                            <TextBlock Text="Stop" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 4. Stop All -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding PauseAllCommand}" ToolTip="Stop all active downloads">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF04DB;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.StatusPaused}" />
                            <TextBlock Text="Stop All" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 5. Delete -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding RemoveCommand}" ToolTip="Delete selected download (Del)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF0A7A;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.StatusFailed}" />
                            <TextBlock Text="Delete" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 6. Delete Completed -->
                    <Button Style="{StaticResource Button.IDMStacked}" MinWidth="80" Command="{Binding ClearCompletedCommand}" ToolTip="Delete all completed downloads">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF0C62;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.StatusFailed}" />
                            <TextBlock Text="Delete Co..." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 7. Options -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding OptionsCommand}" ToolTip="Options &amp; Settings (Ctrl+,)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF08BB;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="Options" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 8. Theme -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeButtonToolTip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ThemeButtonIcon}" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding ThemeButtonLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 9. About -->
                    <Button Style="{StaticResource Button.IDMStacked}" Command="{Binding AboutCommand}" ToolTip="About Windows Download Manager">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF02FD;" Style="{StaticResource Toolbar.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="About" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 3. Main Body (Categories Tree Sidebar + IDM Download Table) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories Tree Sidebar â€” flat background like WDM original (no card) -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="10,6,10,4" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                    <!-- Categories Tree ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Filters}"
                             SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                             SelectedValuePath="Kind"
                             Style="{StaticResource ListBox.Sidebar}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}" Height="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Section Header Label (micro) -->
                                    <TextBlock Grid.ColumnSpan="3" Text="{Binding HeaderText}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"
                                               Margin="4,4,0,2" VerticalAlignment="Center"
                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />

                                    <!-- Category Divider -->
                                    <Border Grid.ColumnSpan="3" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,2" VerticalAlignment="Center" Opacity="0.35"
                                            Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />

                                    <!-- Category Icon -->
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Category Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Category Count -->
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="6,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- IDM Download DataGrid Table -->
            <Grid Grid.Column="2" Margin="4,0,8,8">
                <Border Style="{StaticResource CardShadow.Base}" />
                <Border x:Name="ListCard" Style="{StaticResource Card.Base}" Padding="10,8">
                    <Grid>
                    <DataGrid x:Name="TaskGrid"
                          ItemsSource="{Binding TasksView}"
                          SelectedItem="{Binding SelectedTask}"
                          SelectionChanged="TaskGrid_SelectionChanged"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          RowHeight="38"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="TaskGrid_MouseDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="A" Modifiers="Control" Command="SelectAll" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Open" Command="{Binding OpenFileCommand}" FontWeight="Bold">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF03CB;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open folder" Command="{Binding RevealCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0770;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open" Command="{Binding OpenFileCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF03CC;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF040A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Pause" Command="{Binding PauseCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF03E4;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Restart" Command="{Binding RetryCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0709;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop" Command="{Binding StopCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF04DB;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Refresh link..." Command="{Binding RefreshLinkCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0339;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF018F;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy file path" Command="{Binding RevealCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF018F;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Priority">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0603;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                                <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
                                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                            </MenuItem>
                            <MenuItem Header="Move up" Command="{Binding MoveUpCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF005D;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Move down" Command="{Binding MoveDownCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0045;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF11E8;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Command="{Binding RemoveCommand}" InputGestureText="Del">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete with file" Command="{Binding RemoveWithFileCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.StatusFailed}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- File Name + Icon -->
                        <DataGridTemplateColumn Header="File Name" Width="*" MinWidth="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                                        <TextBlock Text="{Binding TypeIcon}" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayFileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" ToolTip="{Binding DisplayFileName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size -->
                        <DataGridTemplateColumn Header="Size" Width="85" HeaderStyle="{StaticResource Header.Center}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontFamily="Consolas, monospace" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Status" Width="115" HeaderStyle="{StaticResource Header.Center}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Medium"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Time left -->
                        <DataGridTemplateColumn Header="Time left" Width="80" HeaderStyle="{StaticResource Header.Right}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Eta}" FontFamily="Consolas, monospace" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Transfer rate -->
                        <DataGridTemplateColumn Header="Transfer rate" Width="105" HeaderStyle="{StaticResource Header.Right}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SpeedText}" FontFamily="Consolas, monospace" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Last Try Date -->
                        <DataGridTemplateColumn Width="110" HeaderStyle="{StaticResource Header.Right}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Last Try Date" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AddedAt, StringFormat='{}{0:MMM dd HH:mm}'}"
                                               Style="{StaticResource Cell.RightDim}" Margin="6,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Placeholder -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding HasNoVisibleTasks, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="6" Effect="{StaticResource Shadow.ButtonStrong}" />
                    <Border Padding="32,24" Background="{DynamicResource Brush.Surface}" CornerRadius="6">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="&#xF01DA;" FontFamily="{StaticResource Font.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding EmptyStateSubtitle}" Foreground="{DynamicResource Brush.TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                            <Button Content="+ Add URL" Style="{StaticResource Button.Accent}" Command="{Binding OpenAddDialogCommand}" HorizontalAlignment="Center" Width="120" Height="30" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="Transparent" Margin="0" Padding="10,0" BorderThickness="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="SparklineCanvas" Width="80" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusRightText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="10" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

