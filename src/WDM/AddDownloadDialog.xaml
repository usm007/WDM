<Window x:Class="WDM.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Download — WDM"
        Icon="Assets/WDM.ico"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Content Body -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
        </Grid.RowDefinitions>

        <!-- Main Body -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <!-- Header with Category Badge -->
            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <StackPanel x:Name="FileCategoryBadge" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="FileCategoryIcon" Text="&#xF0224;" FontFamily="{StaticResource Font.Icon}"
                               FontSize="13.5" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="FileCategoryLabel" Text="File" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Add Download" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Enter the source link and destination settings." FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1.5,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Form Fields Grid -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- URL -->
                    <RowDefinition Height="Auto" /> <!-- Save to -->
                    <RowDefinition Height="Auto" /> <!-- File name -->
                    <RowDefinition Height="Auto" /> <!-- Category -->
                    <RowDefinition Height="Auto" /> <!-- YouTube Options -->
                    <RowDefinition Height="Auto" /> <!-- Advanced Options -->
                </Grid.RowDefinitions>

                <!-- URL -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center"
                             Padding="8,0" Height="28" FontSize="13" FontFamily="{StaticResource Font.App}" />
                    <Border x:Name="ProbeBadge" CornerRadius="3" Padding="6,3" Margin="0,4,0,0" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceAlt}">
                        <DockPanel>
                            <!-- YouTube thumbnail -->
                            <Image x:Name="YtThumbnail" DockPanel.Dock="Left" Width="64" Height="36"
                                   Stretch="UniformToFill" Margin="0,0,8,0" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="3" RadiusY="3" Rect="0,0,64,36" />
                                </Image.Clip>
                            </Image>
                            <TextBlock x:Name="ProbeIcon" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock x:Name="ProbeText" Text="Analyzing link…" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="DuplicateWarning" Visibility="Collapsed" FontSize="12"
                               Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0"
                               Text="This URL is already in your download list." />
                </StackPanel>

                <!-- Save to -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Save to" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"
                             Padding="8,0" Height="28" FontSize="13" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Secondary}"
                            Click="BrowseClick" Margin="6,0,0,0" Padding="12,0" Height="28" />
                </Grid>

                <!-- File name -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="File name" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NameBox" TextChanged="NameBox_TextChanged"
                         VerticalContentAlignment="Center" Padding="8,0" Height="28" FontSize="13" Margin="0,0,0,10" />

                <!-- Category -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged"
                          Height="28" Margin="0,0,0,10">
                    <ComboBoxItem Content="Auto detect" Tag="Auto" />
                    <ComboBoxItem Content="Video" Tag="Video" />
                    <ComboBoxItem Content="Music" Tag="Music" />
                    <ComboBoxItem Content="Document" Tag="Document" />
                    <ComboBoxItem Content="Compressed" Tag="Compressed" />
                    <ComboBoxItem Content="Program" Tag="Program" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>

                <!-- YouTube Download Options -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="YouTubePanel"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="YouTube Media Options" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="YtTypeVideoAudio" Content="Video + Audio" GroupName="YtType" IsChecked="True" Checked="YtType_Changed" Margin="0,0,16,0" FontSize="13" />
                            <RadioButton x:Name="YtTypeVideoOnly" Content="Video only" GroupName="YtType" Checked="YtType_Changed" Margin="0,0,16,0" FontSize="13" />
                            <RadioButton x:Name="YtTypeAudioOnly" Content="Audio only" GroupName="YtType" Checked="YtType_Changed" FontSize="13" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="YtQualityLabel" Text="Quality" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="YtQualityBox" Height="28" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="YtContainerPanel">
                                <TextBlock Text="Container" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="YtContainerBox" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="" />
                                    <ComboBoxItem Content="MP4" Tag="mp4" />
                                    <ComboBoxItem Content="WebM" Tag="webm" />
                                    <ComboBoxItem Content="MKV" Tag="mkv" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="YtAudioFormatPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Audio format" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="YtAudioFormatBox" Height="28" Width="140" SelectedIndex="0" SelectionChanged="YtAudioFormat_Changed">
                                <ComboBoxItem Content="Best (original)" Tag="best" />
                                <ComboBoxItem Content="MP3" Tag="mp3" />
                                <ComboBoxItem Content="M4A" Tag="m4a" />
                                <ComboBoxItem Content="Opus" Tag="opus" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="YtEmbedThumb" Content="Embed thumbnail" IsChecked="True" FontSize="13" Margin="0,0,16,0" />
                            <CheckBox x:Name="YtEmbedSubs" Content="Embed subtitles" FontSize="13" Margin="0,0,16,0" />
                            <CheckBox x:Name="YtPlaylist" Content="Download entire playlist" FontSize="13" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced options -->
                <Expander Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                          Header="Advanced options" Foreground="{DynamicResource Brush.TextDim}"
                          FontSize="12" FontWeight="Medium" Margin="0,0,0,6">
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Segment threads" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="ChunksBox" Height="28">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="0" />
                                    <ComboBoxItem Content="1 thread" Tag="1" />
                                    <ComboBoxItem Content="2 threads" Tag="2" />
                                    <ComboBoxItem Content="4 threads" Tag="4" />
                                    <ComboBoxItem Content="8 threads" Tag="8" />
                                    <ComboBoxItem Content="16 threads" Tag="16" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Speed limit (KB/s)" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <TextBox x:Name="SpeedBox" Text="0" ToolTip="0 = Unlimited"
                                         VerticalContentAlignment="Center" Padding="6,0" Height="28" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Mirror URLs (one per line)" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                            <TextBox x:Name="MirrorsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="44"
                                     VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="12.5"
                                     FontFamily="{StaticResource Font.App}" />
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Custom headers (Header: Value)" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                            <TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="44"
                                     VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="12.5"
                                     FontFamily="{StaticResource Font.App}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </StackPanel>

        <!-- Bottom Action Strip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="True">
                <Button x:Name="DownloadLaterButton" DockPanel.Dock="Left" Content="Download later" Style="{StaticResource Button.Secondary}"
                        Click="DownloadLaterClick" MinWidth="105" Height="28" Margin="0,0,10,0" IsEnabled="False" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="CancelClick"
                            MinWidth="75" Height="28" Margin="0,0,8,0" />
                    <Button x:Name="OkButton" Content="Start download" Style="{StaticResource Button.Accent}"
                            Click="OkClick" MinWidth="110" Height="28" IsEnabled="False" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="StartHint" Text="Enter a valid URL above to continue"
                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center" Visibility="Visible" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
