<Window x:Class="WDM.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Download — WDM"
        Icon="Assets/WDM.ico"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Add Download" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="Enter the URL and configure download settings below." FontSize="11"
                           Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0" />
            </StackPanel>
            <Border x:Name="FileCategoryBadge" DockPanel.Dock="Right" Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="6" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FileCategoryIcon" Text="&#xF0224;" FontFamily="{StaticResource Font.Icon}"
                               FontSize="13" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="FileCategoryLabel" Text="File" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Form Fields -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- URL -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Top" Margin="0,7,10,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center"
                         Padding="8,0" Height="28" FontSize="12" />
                <Border x:Name="ProbeBadge" CornerRadius="4" Padding="8,3" Margin="0,3,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="ProbeIcon" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                   Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock x:Name="ProbeText" Text="Analyzing link..." FontSize="11"
                                   Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="DuplicateWarning" Visibility="Collapsed" FontSize="11"
                           Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0"
                           Text="This URL is already in your download list." />
            </StackPanel>

            <!-- Save location -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Save to" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"
                         Padding="8,0" Height="28" FontSize="12" />
                <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Secondary}"
                        Click="BrowseClick" Margin="8,0,0,0" Padding="12,0" Height="28" />
            </Grid>

            <!-- File name -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="File name" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="NameBox" TextChanged="NameBox_TextChanged"
                     VerticalContentAlignment="Center" Padding="8,0" Height="28" FontSize="12" Margin="0,0,0,10" />

            <!-- Category -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,10,10" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged"
                      Height="28" Margin="0,0,0,10">
                <ComboBoxItem Content="Auto detect" Tag="Auto" />
                <ComboBoxItem Content="Video" Tag="Video" />
                <ComboBoxItem Content="Music" Tag="Music" />
                <ComboBoxItem Content="Document" Tag="Document" />
                <ComboBoxItem Content="Compressed" Tag="Compressed" />
                <ComboBoxItem Content="Program" Tag="Program" />
                <ComboBoxItem Content="Other" Tag="Other" />
            </ComboBox>

            <!-- Advanced options -->
            <Expander Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                      Header="Advanced options" Foreground="{DynamicResource Brush.TextDim}"
                      FontSize="11" FontWeight="Medium" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Connection threads" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ChunksBox" Height="26">
                                <ComboBoxItem Content="Auto (recommended)" Tag="0" />
                                <ComboBoxItem Content="1 thread" Tag="1" />
                                <ComboBoxItem Content="2 threads" Tag="2" />
                                <ComboBoxItem Content="4 threads" Tag="4" />
                                <ComboBoxItem Content="8 threads" Tag="8" />
                                <ComboBoxItem Content="16 threads" Tag="16" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Speed limit (KB/s)" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                            <TextBox x:Name="SpeedBox" Text="0" ToolTip="0 = Unlimited"
                                     VerticalContentAlignment="Center" Padding="6,0" Height="26" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Mirror URLs (one per line — used if the main link fails)"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                        <TextBox x:Name="MirrorsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                 VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="12"
                                 ToolTip="Alternative links to the same file. WDM switches to the next mirror automatically when the current URL keeps failing." />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Custom headers (one per line — Header: Value)"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                        <TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                 VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="12"
                                 ToolTip="Extra HTTP headers sent with each request. Useful for authenticated downloads.&#10;Example: Cookie: session=abc123&#10;Example: Authorization: Bearer token123" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="2" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14" />

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="StartHint" DockPanel.Dock="Left" Text="Enter a valid URL above to continue"
                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center" Visibility="Visible" />
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="CancelClick"
                    DockPanel.Dock="Right" MinWidth="85" Height="30" />
            <Button x:Name="OkButton" Content="Start download" Style="{StaticResource Button.Accent}"
                    Click="OkClick" DockPanel.Dock="Right" MinWidth="130" Height="30" Margin="0,0,8,0" IsEnabled="False" />
        </DockPanel>
    </Grid>
</Window>
