<Window x:Class="WDM.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Download — WDM"
        Icon="Assets/WDM.ico"
        Width="680"
        MinHeight="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Add Download" Style="{StaticResource Text.DialogTitle}" />
                <TextBlock Text="Enter a URL and configure the download." Style="{StaticResource Text.DialogSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border x:Name="FileCategoryBadge" DockPanel.Dock="Right"
                    Background="{DynamicResource Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Brush.AccentSoftStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FileCategoryIcon" Text="&#xE7C3;" FontFamily="{StaticResource Font.Icon}"
                               FontSize="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="FileCategoryLabel" Text="File" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- URL: primary input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="URL" Style="{StaticResource Text.DialogSection}" />
            <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged"
                     Height="44" FontSize="13" />
            <Border x:Name="ProbeBadge" CornerRadius="8" Padding="10,6" Margin="0,6,0,0"
                    Background="{DynamicResource Brush.AccentSoft}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="ProbeIcon" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                               Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="ProbeText" Text="Analyzing link..." FontSize="11"
                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="DuplicateWarning" Visibility="Collapsed" FontSize="11"
                       Foreground="{DynamicResource Brush.Warning}" Margin="0,6,0,0"
                       Text="This URL is already in your download list." />
        </StackPanel>

        <!-- Download details -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="18"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Download details" Style="{StaticResource Text.DialogSection}" />

                <TextBlock Text="Save to" Style="{StaticResource Label.Field}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Secondary}"
                            Click="BrowseClick" Margin="10,0,0,0" MinWidth="90" />
                </Grid>

                <TextBlock Text="File name" Style="{StaticResource Label.Field}" />
                <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" Margin="0,0,0,14" />

                <TextBlock Text="Category" Style="{StaticResource Label.Field}" />
                <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged">
                    <ComboBoxItem Content="Auto detect" Tag="Auto" />
                    <ComboBoxItem Content="Video" Tag="Video" />
                    <ComboBoxItem Content="Music" Tag="Music" />
                    <ComboBoxItem Content="Document" Tag="Document" />
                    <ComboBoxItem Content="Compressed" Tag="Compressed" />
                    <ComboBoxItem Content="Program" Tag="Program" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Advanced options + footer -->
        <StackPanel Grid.Row="3">
            <Border Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,18">
                <Expander Header="Advanced options" Foreground="{DynamicResource Brush.Text}"
                          FontSize="12" FontWeight="SemiBold">
                    <StackPanel Margin="0,14,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Connection threads" Style="{StaticResource Label.Field}" />
                                <ComboBox x:Name="ChunksBox">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="0" />
                                    <ComboBoxItem Content="1 thread" Tag="1" />
                                    <ComboBoxItem Content="2 threads" Tag="2" />
                                    <ComboBoxItem Content="4 threads" Tag="4" />
                                    <ComboBoxItem Content="8 threads" Tag="8" />
                                    <ComboBoxItem Content="16 threads" Tag="16" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Speed limit (KB/s)" Style="{StaticResource Label.Field}" />
                                <TextBox x:Name="SpeedBox" Text="0" ToolTip="0 = Unlimited" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Mirror URLs (one per line — used if the main link fails)"
                                   Style="{StaticResource Label.Field}" Margin="0,16,0,5" />
                        <TextBox x:Name="MirrorsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="58"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Alternative links to the same file. WDM switches to the next mirror automatically when the current URL keeps failing." />
                    </StackPanel>
                </Expander>
            </Border>

            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,16" />

            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StartHint" DockPanel.Dock="Left"
                           Text="Enter a valid URL above to continue"
                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center" Visibility="Visible" />
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="CancelClick"
                        DockPanel.Dock="Right" MinWidth="100" Height="40" />
                <Button x:Name="OkButton" Content="Start download" Style="{StaticResource Button.Accent}"
                        Click="OkClick" DockPanel.Dock="Right" MinWidth="145" Height="40" Margin="0,0,10,0" IsEnabled="False" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
