<ui:FluentWindow x:Class="WDM.CloudflareChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cloudflare Protection Solver — WDM"
        Icon="Assets/WDM.ico"
        Height="580"
        Width="820"
        MinHeight="450"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource Brush.Bg}">

    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- WebView2 Content -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Cloudflare Protection Solver">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Top Instructions Header -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="ShieldLock24" FontSize="20" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Cloudflare Verification Required" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Complete the Cloudflare check below. WDM will automatically capture clearance cookies and resume your download."
                           FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- WebView2 Challenge Browser -->
        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border x:Name="LoadingOverlay" Background="{DynamicResource Brush.Surface}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="24" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Initializing browser session…" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Action Strip -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <ui:Button Content="Cancel" Style="{StaticResource Button.SecondaryAction}" Click="Cancel_Click" MinWidth="85" Height="32" DockPanel.Dock="Left" IsCancel="True" />
                <ui:Button x:Name="UseCookiesBtn" Content="Apply Clearance &amp; Resume" Style="{StaticResource Button.PrimaryAction}" Click="ApplyClearance_Click" Height="32" Padding="16,0" DockPanel.Dock="Right" IsDefault="True" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
