<Window x:Class="WDM.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
         Title="{Binding Task.FileName, StringFormat='{}{0} — WDM'}"
         Icon="Assets/WDM.ico"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:TextToVisibilityConverter x:Key="TextVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Button.ProgressTab: Real modern Fluent button appearance for tab toggles -->
        <Style x:Key="Button.ProgressTab" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Empty}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="16,14,16,12">

                <!-- 1. Window Header -->
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.DialogMinimize}" Click="MinimizeClick" Margin="0,-4,2,0" />
                        <Button Style="{StaticResource Button.DialogClose}" ToolTip="Close (Esc)" Click="CloseClick" Margin="0,-4,-6,0" />
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Task.TypeSymbol}"
                                       FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Task.FileName}" FontWeight="SemiBold" FontSize="13.5"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Task.FileName}" />
                    </DockPanel>
                </DockPanel>

                <!-- 2. Studio Card -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- File Name -->
                        <TextBlock Text="{Binding Task.FileName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Task.FileName}" Margin="0,0,0,5" />
                        
                        <!-- Size & Percentage (Clean, non-compact, no extra clutter) -->
                        <TextBlock FontSize="12" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6">
                            <Run Text="{Binding Task.DownloadedText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Task.SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Task.Progress, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>

                        <!-- Preparing status line: visible from session start until first bytes flow -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"
                                    Visibility="{Binding Task.IsPreparing, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PrepDot" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </StackPanel.Triggers>
                            <Ellipse x:Name="PrepDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding Task.PhaseText, FallbackValue='Preparing…'}" FontSize="12"
                                       FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Accent}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Progress Bar -->
                        <Border Background="{DynamicResource Brush.Border}" Height="6" CornerRadius="3" Margin="0,0,0,4">
                            <Grid Height="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding YouTubeProgressFill}" />
                                    <ColumnDefinition Width="{Binding YouTubeProgressRemaining}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="3" />
                            </Grid>
                        </Border>

                        <!-- Indeterminate marquee while preparing (no stats yet) -->
                        <ProgressBar Height="4" Margin="0,0,0,12" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Brush.Accent}" IsIndeterminate="True"
                                     Visibility="{Binding Task.IsPreparing, Converter={StaticResource BoolToVis}}" />

                        <!-- Metrics Row: Speed, ETA, Threads -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Speed" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Task.SpeedText, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <TextBlock Text="ETA" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Task.Eta, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <TextBlock Text="Threads" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ChunkCountText}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hidden holders for code-behind compatibility -->
                <TextBlock x:Name="ResumeLabel" Visibility="Collapsed" Text="{Binding Task.ResumeCapabilityText}" />
                <TextBlock x:Name="ResumeValue" Visibility="Collapsed" Text="{Binding Task.ResumeCapabilityText}" />
                <StackPanel x:Name="HttpExtraPanel" Visibility="Collapsed" />
                <StackPanel x:Name="YouTubeExtraPanel" Visibility="Collapsed" />

                <!-- 3. Button Strip: Details, Speed Limiter, On Completion -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- Button 1: Details -->
                    <RadioButton x:Name="TabDetails" Style="{StaticResource Button.ProgressTab}"
                                 IsChecked="False" Checked="Tab_Checked" Unchecked="Tab_Unchecked"
                                 PreviewMouseLeftButtonDown="Tab_PreviewMouseDown" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Details" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Button 2: Speed Limiter -->
                    <RadioButton x:Name="TabLimiter" Style="{StaticResource Button.ProgressTab}"
                                 IsChecked="False" Checked="Tab_Checked" Unchecked="Tab_Unchecked"
                                 PreviewMouseLeftButtonDown="Tab_PreviewMouseDown" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TopSpeed20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Speed Limiter" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Button 3: On Completion -->
                    <RadioButton x:Name="TabOptions" Style="{StaticResource Button.ProgressTab}"
                                 IsChecked="False" Checked="Tab_Checked" Unchecked="Tab_Unchecked"
                                 PreviewMouseLeftButtonDown="Tab_PreviewMouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="On Completion" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 4. Tab Content Host -->
                <Grid x:Name="MainContentHost" Margin="0,0,0,6">
                    <StackPanel x:Name="PanelStatus" Visibility="Collapsed" />

                    <!-- TAB 1: Details Panel (Textual + Graphical) -->
                    <StackPanel x:Name="PanelDetails" Visibility="Collapsed" Margin="0,2,0,8">
                        <!-- Graphical File Map (block visualization: 1 block = 1/64 of the file) -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="FILE MAP · 64 SEGMENTS" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BlockSummaryText}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- File block map -->
                                <ItemsControl ItemsSource="{Binding BlockList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="32" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="14" CornerRadius="2.5" Margin="1.5"
                                                    ToolTip="{Binding ToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Track}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoftStrong}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Downloaded" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.AccentSoftStrong}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Downloading" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.Track}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Pending" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Textual Details -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- URL -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3">
                                    <Button Style="{StaticResource Button.CommandBarIcon}" Click="CopyUrl_Click" ToolTip="Copy URL"
                                            DockPanel.Dock="Right" Padding="4,1" Margin="4,0,0,0">
                                        <ui:SymbolIcon Symbol="Copy20" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    </Button>
                                    <TextBlock Text="{Binding Task.Url}" FontSize="11" FontFamily="{StaticResource Font.Code}"
                                               Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding Task.Url}" />
                                </DockPanel>

                                <!-- Save Path -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Save to" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Task.FullPath}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" Margin="0,3" VerticalAlignment="Center"
                                           ToolTip="{Binding Task.FullPath}" />

                                <!-- Category & Status -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Task.Category}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Text}" Margin="0,0,12,0" />
                                    <TextBlock Text="Status: " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Text="{Binding Task.Status}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Task.Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>

                                <!-- Server Resume Support -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Server resume" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Task.ResumeCapabilityText, TargetNullValue='Supported (HTTP Range)'}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,3" VerticalAlignment="Center" />

                                <!-- Added Date -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Added date" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Task.AddedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: Speed Limiter -->
                    <StackPanel x:Name="PanelLimiter" Visibility="Collapsed" Margin="0,4,0,8">
                        <CheckBox x:Name="CheckSpeedLimit" Content="Limit the speed for this download task"
                                  IsChecked="{Binding IsSpeedLimitEnabled, Mode=TwoWay}"
                                  Checked="SpeedLimit_Changed" Unchecked="SpeedLimit_Changed"
                                  FontSize="13" FontWeight="Medium" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max speed limit:" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                            <ui:TextBox Grid.Column="1" Text="{Binding TaskSpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalContentAlignment="Center" Padding="8,0" Height="32" FontSize="13"
                                          PlaceholderText="0"
                                          AutomationProperties.Name="Max speed limit" />
                            <TextBlock Grid.Column="2" Text="KB/s" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- TAB 3: On Completion -->
                    <StackPanel x:Name="PanelOptions" Visibility="Collapsed" Margin="0,4,0,8">
                        <CheckBox Content="Close this window automatically when finished"
                                  IsChecked="{Binding CloseOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                        <CheckBox Content="Open file automatically when finished"
                                  IsChecked="{Binding OpenOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                        <CheckBox Content="Shutdown computer after all active downloads finish"
                                  IsChecked="{Binding ShutdownOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,4" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Bottom Action Strip -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <ui:Button Content="Open Folder" Style="{StaticResource Button.SecondaryAction}" Click="RevealClick" Height="32" Padding="12,0" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ui:Button x:Name="BtnPause" Content="Pause" Style="{StaticResource Button.SecondaryAction}"
                                   Click="PauseClick" IsEnabled="{Binding CanPause}" MinWidth="80" Height="32" Margin="0,0,6,0" />
                        <ui:Button x:Name="BtnResume" Content="Resume" Style="{StaticResource Button.PrimaryAction}"
                                   Click="ResumeClick" IsEnabled="{Binding CanResume}" MinWidth="80" Height="32" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

