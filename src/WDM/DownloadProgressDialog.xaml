<Window x:Class="WDM.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="{Binding Task.FileName, StringFormat='{}{0} — WDM'}"
        Icon="Assets/WDM.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:TextToVisibilityConverter x:Key="TextVis" />
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="16,14,16,12">

                <!-- 1. Window Header -->
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.DialogMinimize}" Click="MinimizeClick" Margin="0,-4,2,0" />
                        <Button Style="{StaticResource Button.DialogClose}" ToolTip="Close (Esc)" Click="CloseClick" Margin="0,-4,-6,0" />
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Task.TypeIcon}" FontFamily="{StaticResource Font.Icon}"
                                   FontSize="15" Foreground="{DynamicResource Brush.TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Task.FileName}" FontWeight="SemiBold" FontSize="13.5"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Task.FileName}" />
                    </DockPanel>
                </DockPanel>

                <!-- 2. Studio Card (no thumbnail) -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Task.FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Task.FileName}" />
                        <TextBlock FontSize="11.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0">
                            <Run Text="{Binding Task.DownloadedText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Task.SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Task.Progress, Mode=OneWay}"/><Run Text="% — HLS segment stream"/>
                        </TextBlock>
                        <Border Background="{DynamicResource Brush.Border}" Height="5" CornerRadius="3" Margin="0,10,0,0">
                            <Grid Height="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding YouTubeProgressFill}" />
                                    <ColumnDefinition Width="{Binding YouTubeProgressRemaining}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="3" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Speed" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Task.SpeedText, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="16,0,0,0">
                                <TextBlock Text="ETA" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Task.Eta, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="16,0,0,0">
                                <TextBlock Text="Threads" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ChunkCountText}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hidden holders for code-behind compatibility -->
                <TextBlock x:Name="ResumeLabel" Visibility="Collapsed" Text="{Binding Task.ResumeCapabilityText}" />
                <TextBlock x:Name="ResumeValue" Visibility="Collapsed" Text="{Binding Task.ResumeCapabilityText}" />
                <StackPanel x:Name="HttpExtraPanel" Visibility="Collapsed" />
                <StackPanel x:Name="YouTubeExtraPanel" Visibility="Collapsed" />
                <!-- 3. Tab Navigation Strip — titles visible, sections hidden until click -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="TabStatus" Content="Status" Style="{StaticResource Tab.Item}" Visibility="Collapsed"
                                 IsChecked="False" Checked="Tab_Checked" Margin="0,0,6,0" FontSize="12" />
                    <RadioButton x:Name="TabLimiter" Content="Speed Limiter" Style="{StaticResource Tab.Item}"
                                 IsChecked="False" Checked="Tab_Checked" Margin="0,0,6,0" FontSize="12" />
                    <RadioButton x:Name="TabOptions" Content="On Completion" Style="{StaticResource Tab.Item}"
                                 IsChecked="False" Checked="Tab_Checked" FontSize="12" />
                </StackPanel>

                <!-- 4. Tab Content Host — hidden until a tab is clicked -->
                <Grid x:Name="MainContentHost" Margin="0,0,0,6">
                    <StackPanel x:Name="PanelStatus" Visibility="Collapsed" />

                    <!-- TAB 2: Speed Limiter -->
                    <StackPanel x:Name="PanelLimiter" Visibility="Collapsed" Margin="0,4,0,8">
                        <CheckBox x:Name="CheckSpeedLimit" Content="Limit the speed for this download task"
                                  IsChecked="{Binding IsSpeedLimitEnabled, Mode=TwoWay}"
                                  Checked="SpeedLimit_Changed" Unchecked="SpeedLimit_Changed"
                                  FontSize="13" FontWeight="Medium" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max speed limit:" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBox Grid.Column="1" Text="{Binding TaskSpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Padding="8,0" Height="28" FontSize="13" />
                            <TextBlock Grid.Column="2" Text="KB/s" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- TAB 3: On Completion -->
                    <StackPanel x:Name="PanelOptions" Visibility="Collapsed" Margin="0,4,0,8">
                        <CheckBox Content="Close this window automatically when finished"
                                  IsChecked="{Binding CloseOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                        <CheckBox Content="Open file automatically when finished"
                                  IsChecked="{Binding OpenOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                        <CheckBox Content="Shutdown computer after all active downloads finish"
                                  IsChecked="{Binding ShutdownOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,4" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Bottom Action Strip (no Close) -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <Button Content="Open Folder" Style="{StaticResource Button.Secondary}" Click="RevealClick" Height="28" Padding="12,0" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnPause" Content="Pause" Style="{StaticResource Button.Secondary}"
                                Click="PauseClick" IsEnabled="{Binding CanPause}" MinWidth="80" Height="28" Margin="0,0,6,0" />
                        <Button x:Name="BtnResume" Content="Resume" Style="{StaticResource Button.Accent}"
                                Click="ResumeClick" IsEnabled="{Binding CanResume}" MinWidth="80" Height="28" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

