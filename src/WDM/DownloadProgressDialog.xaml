<Window x:Class="WDM.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        Title="{Binding Task.FileName, StringFormat='{}{0} — WDM'}"
        Icon="Assets/WDM.ico"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:TextToVisibilityConverter x:Key="TextVis" />
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="16,14,16,12">
                <!-- 1. Header: Icon + File Name + Progress Percentage + Caption Buttons -->
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressTitleText}"
                                   FontSize="13" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="10,0,8,0" />
                        <Button Style="{StaticResource Button.DialogMinimize}" Click="MinimizeClick" Margin="0,-4,2,0" />
                        <Button Style="{StaticResource Button.DialogClose}" ToolTip="Close (Esc)" Click="CloseClick" Margin="0,-4,-6,0" />
                    </StackPanel>

                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Task.TypeIcon}" FontFamily="{StaticResource Font.Icon}"
                                   FontSize="15" Foreground="{DynamicResource Brush.TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Task.FileName}" FontWeight="SemiBold" FontSize="13.5"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Task.FileName}" />
                    </DockPanel>
                </DockPanel>

            <!-- 2. Tab Navigation Strip -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="TabStatus" Content="Status" Style="{StaticResource Tab.Item}"
                             IsChecked="True" Checked="Tab_Checked" Margin="0,0,6,0" FontSize="12" />
                <RadioButton x:Name="TabLimiter" Content="Speed Limiter" Style="{StaticResource Tab.Item}"
                             Checked="Tab_Checked" Margin="0,0,6,0" FontSize="12" />
                <RadioButton x:Name="TabOptions" Content="On Completion" Style="{StaticResource Tab.Item}"
                             Checked="Tab_Checked" FontSize="12" />
            </StackPanel>

            <!-- 3. Tab Content Host -->
            <Grid x:Name="MainContentHost" Margin="0,0,0,6">
                <!-- TAB 1: Status & Telemetry -->
                <StackPanel x:Name="PanelStatus">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" /> <!-- URL -->
                            <RowDefinition Height="26" /> <!-- Status -->
                            <RowDefinition Height="26" /> <!-- File Size -->
                            <RowDefinition Height="26" /> <!-- Downloaded -->
                            <RowDefinition Height="26" /> <!-- Speed -->
                            <RowDefinition Height="26" /> <!-- Time Left -->
                            <RowDefinition Height="26" /> <!-- Resume -->
                        </Grid.RowDefinitions>

                        <!-- URL -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source URL" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.RowAction}" Click="CopyUrl_Click" ToolTip="Copy URL" Width="20" Height="20" Margin="4,0,0,0">
                                <TextBlock Text="&#xF0770;" FontFamily="{StaticResource Font.Icon}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                            </Button>
                            <TextBox Text="{Binding Task.Url}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="{StaticResource Font.App}" FontSize="12.5" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                     Padding="0" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <!-- Status -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding Task.Status, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding Task.StatusText}" FontWeight="Normal"
                                       Foreground="{Binding Task.Status, Converter={StaticResource StatusBrush}}"
                                       FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- File Size -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="File size" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Task.SizeText}" FontSize="13" FontWeight="Normal" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />

                        <!-- Downloaded -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Transferred" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DownloadedDetailText}" FontWeight="Normal"
                                   FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Text}" FontSize="13" VerticalAlignment="Center" />

                        <!-- Transfer Rate -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer rate" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Task.SpeedText, TargetNullValue='0 B/s'}"
                                   FontWeight="Normal" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Accent}"
                                   FontSize="13" VerticalAlignment="Center" />

                        <!-- Time Left -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Time remaining" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Task.Eta}" FontSize="13" FontWeight="Normal" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />

                        <!-- Resume Capability (HTTP only) -->
                        <TextBlock x:Name="ResumeLabel" Grid.Row="6" Grid.Column="0" Text="Server range" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResumeValue" Grid.Row="6" Grid.Column="1" Text="{Binding Task.ResumeCapabilityText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- HTTP-specific: Multi-Thread Progress Segment Visualizer -->
                    <StackPanel x:Name="HttpExtraPanel">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Segment progress by thread:" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChunkCountText}" FontSize="12" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Background="{DynamicResource Brush.Border}" Height="6" CornerRadius="2" Padding="0.5">
                            <ItemsControl x:Name="ChunkListHost" ItemsSource="{Binding ChunkList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0.5,0" ToolTip="{Binding ToolTip}">
                                            <Grid Height="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding FillGridLength}" />
                                                    <ColumnDefinition Width="{Binding RemainingGridLength}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="1" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- YouTube-specific: Single stream progress (different system) -->
                    <StackPanel x:Name="YouTubeExtraPanel" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="YouTube progress:" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding YouTubeEngineText}" FontSize="12" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Background="{DynamicResource Brush.Border}" Height="6" CornerRadius="2" Padding="0.5">
                            <Grid Height="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding YouTubeProgressFill}" />
                                    <ColumnDefinition Width="{Binding YouTubeProgressRemaining}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="1" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding YouTubeStatusHint}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding YouTubeStatusHint, Converter={StaticResource TextVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- TAB 2: Speed Limiter -->
                <StackPanel x:Name="PanelLimiter" Visibility="Collapsed" Margin="0,4,0,8">
                    <CheckBox x:Name="CheckSpeedLimit" Content="Limit the speed for this download task"
                              IsChecked="{Binding IsSpeedLimitEnabled, Mode=TwoWay}"
                              Checked="SpeedLimit_Changed" Unchecked="SpeedLimit_Changed"
                              FontSize="13" FontWeight="Medium" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max speed limit:" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBox Grid.Column="1" Text="{Binding TaskSpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="8,0" Height="28" FontSize="13" />
                        <TextBlock Grid.Column="2" Text="KB/s" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- TAB 3: On Completion -->
                <StackPanel x:Name="PanelOptions" Visibility="Collapsed" Margin="0,4,0,8">
                    <CheckBox Content="Close this window automatically when finished"
                              IsChecked="{Binding CloseOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                    <CheckBox Content="Open file automatically when finished"
                              IsChecked="{Binding OpenOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,8" />
                    <CheckBox Content="Shutdown computer after all active downloads finish"
                              IsChecked="{Binding ShutdownOnComplete, Mode=TwoWay}" FontSize="13" Margin="0,0,0,4" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Bottom Action Strip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button Content="Open Folder" Style="{StaticResource Button.Secondary}" Click="RevealClick" Height="28" Padding="12,0" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnPause" Content="Pause" Style="{StaticResource Button.Secondary}"
                            Click="PauseClick" IsEnabled="{Binding CanPause}" MinWidth="80" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnResume" Content="Resume" Style="{StaticResource Button.Accent}"
                            Click="ResumeClick" IsEnabled="{Binding CanResume}" MinWidth="80" Height="28" Margin="0,0,6,0" />
                    <Button Content="Close" Style="{StaticResource Button.Secondary}"
                            Click="CancelClick" MinWidth="75" Height="28" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
