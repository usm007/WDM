<Window x:Class="WDM.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete"
        Icon="Assets/WDM.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: trash icon + message -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brush.StatusFailedSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xF0A7A;" FontFamily="{StaticResource Font.Icon}" FontSize="24"
                           Foreground="{DynamicResource Brush.StatusFailed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Delete downloads?" Style="{StaticResource Text.Brand}" FontSize="15" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Delete-from-disk checkbox -->
        <CheckBox x:Name="DiskCheckBox" Grid.Row="1"
                  Content="Delete the downloaded file from disk" FontSize="12" FontWeight="Medium"
                  Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,18" VerticalContentAlignment="Center">
            <CheckBox.Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Style>
            </CheckBox.Style>
        </CheckBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="90" Height="30" IsCancel="True" Margin="0,0,8,0" Click="CancelClick" />
            <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Button.Accent}" MinWidth="90" Height="30" IsDefault="True" Click="DeleteClick" />
        </StackPanel>
    </Grid>
</Window>