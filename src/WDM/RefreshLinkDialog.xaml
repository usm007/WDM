<Window x:Class="WDM.RefreshLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh Download Link — WDM"
        Icon="Assets/WDM.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Refresh Download Link" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="The old link stopped working. Provide a replacement URL and the download continues from where it stopped."
                       FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Current state -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="File" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,4,10,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FileNameText" FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Downloaded" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,4,10,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProgressText" FontSize="12"
                       VerticalAlignment="Center" Margin="0,4" />
        </Grid>

        <!-- New URL -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="New download URL" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,5" />
            <TextBox x:Name="UrlBox" VerticalContentAlignment="Center"
                     Padding="8,0" Height="30" FontSize="12" />
            <TextBlock x:Name="HintText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap">
                If the new link points to the same file (same size), the download resumes from its current progress.
                A different size restarts the download from zero.
            </TextBlock>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Row="3" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14" />

        <!-- Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="CancelClick"
                    DockPanel.Dock="Right" MinWidth="85" Height="30" />
            <Button Content="Use link &amp; resume" Style="{StaticResource Button.Accent}"
                    Click="OkClick" IsDefault="True" DockPanel.Dock="Right" MinWidth="130" Height="30" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>