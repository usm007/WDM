<UserControl x:Class="WDM.OptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             RenderOptions.ClearTypeHint="Enabled"
             Background="{DynamicResource Brush.Surface}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />  <!-- Left Navigation Rail -->
            <ColumnDefinition Width="1" />    <!-- Subtle 1px Divider -->
            <ColumnDefinition Width="*" />    <!-- Right Settings Inspector -->
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="8,10,8,10">
            <DockPanel LastChildFill="True">
                <!-- Top Back Navigation Button -->
                <Button DockPanel.Dock="Top" Style="{StaticResource Button.Secondary}" Click="CloseClick" Height="28" Padding="8,0" Margin="0,0,0,10" ToolTip="Return to downloads list (Esc)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 6,1 L 2,5 L 6,9 M 2,5 L 11,5"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"
                              SnapsToDevicePixels="True" />
                        <TextBlock Text="Downloads" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                </Button>

                <!-- Bottom Auto-Save Subtle Indicator -->
                <Border DockPanel.Dock="Bottom" Margin="2,8,2,0">
                    <TextBlock Text="Changes apply automatically" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>

                <!-- Navigation Items List -->
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. Connection -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" IsChecked="True" Checked="Tab_Checked" Tag="Connection" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0003;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Connection" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Folders & Routing -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Folders" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF024B;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Folders &amp; Routing" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Browser Integration -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Browser" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF059F;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Browser Integration" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. YouTube & Media -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="YouTube" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0381;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="YouTube &amp; Media" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Behavior -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Behavior" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF062E;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Behavior" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 6. Appearance -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Appearance" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF06AA;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Appearance" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 7. Updates -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Updates" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF06B0;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Updates" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 8. Advanced -->
                        <RadioButton Style="{StaticResource Button.SettingsTab}" Checked="Tab_Checked" Tag="Advanced" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0521;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" />
                                <TextBlock Text="Advanced" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 1px Vertical Divider -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" />

        <!-- Right Content Panels Canvas -->
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" Padding="20,12,24,12">
            <Grid>
                <!-- 1. PAGE: CONNECTION & SPEED -->
                <StackPanel x:Name="PanelConnection" Visibility="Visible">
                    <TextBlock Text="Connection &amp; Speed" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Tune how downloads connect, allocate segmented threads, and throttle bandwidth." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Concurrency &amp; segments" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Connections per download" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Parallel HTTP range chunk streams per task." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ChunksBox" Grid.Column="1" Height="26" VerticalAlignment="Center">
                            <ComboBoxItem Content="Auto (recommended)" Tag="0" />
                            <ComboBoxItem Content="1 thread" Tag="1" />
                            <ComboBoxItem Content="2 threads" Tag="2" />
                            <ComboBoxItem Content="4 threads" Tag="4" />
                            <ComboBoxItem Content="8 threads" Tag="8" />
                            <ComboBoxItem Content="16 threads" Tag="16" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Maximum concurrent downloads" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Limit simultaneous downloads before queueing." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="MaxConcurrentBox" Grid.Column="1" Height="26" VerticalAlignment="Center">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="10" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Retry policy &amp; throttling" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,6" />

                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Failure retries" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Automatic reconnect attempts before failing." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="RetriesBox" Grid.Column="1" Height="26" VerticalAlignment="Center">
                            <ComboBoxItem Content="0 (No retries)" />
                            <ComboBoxItem Content="1 retry" />
                            <ComboBoxItem Content="2 retries" />
                            <ComboBoxItem Content="3 retries" />
                            <ComboBoxItem Content="5 retries" />
                            <ComboBoxItem Content="10 retries" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Global speed limit (KB/s)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Bandwidth ceiling across transfers (0 = unlimited)." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="SpeedBox" Grid.Column="1" VerticalContentAlignment="Center" FontSize="12" Height="26" ToolTip="0 = no limit" />
                    </Grid>
                </StackPanel>

                <!-- 2. PAGE: FOLDERS & ROUTING -->
                <StackPanel x:Name="PanelFolders" Visibility="Collapsed">
                    <TextBlock Text="Folders &amp; Routing" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Choose where downloaded files are saved and configure automatic category routing." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Default download location" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />

                    <Grid Margin="0,2,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Default folder" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,3" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Height="26" VerticalContentAlignment="Center" FontSize="12" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Button.Secondary}" Click="BrowseClick" Margin="6,0,0,0" Height="26" Padding="12,0" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="Automatic category routing" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,4" />

                    <CheckBox x:Name="RouteBox" Content="Route categories into dedicated subfolders automatically" FontWeight="Medium" FontSize="12" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="Videos" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                            <TextBox x:Name="VideoFolderBox" Height="24" VerticalContentAlignment="Center" FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                            <TextBlock Text="Music" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                            <TextBox x:Name="MusicFolderBox" Height="24" VerticalContentAlignment="Center" FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="Documents" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                            <TextBox x:Name="DocumentFolderBox" Height="24" VerticalContentAlignment="Center" FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                            <TextBlock Text="Archives" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                            <TextBox x:Name="CompressedFolderBox" Height="24" VerticalContentAlignment="Center" FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock Text="Programs" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                            <TextBox x:Name="ProgramFolderBox" Height="24" VerticalContentAlignment="Center" FontSize="11.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 3. PAGE: BROWSER INTEGRATION -->
                <StackPanel x:Name="PanelBrowser" Visibility="Collapsed">
                    <TextBlock Text="Browser Integration" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Intercept download links automatically from Google Chrome, Edge, Brave, and Chromium browsers." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Native capture service" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Local server running" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" />
                                </StackPanel>
                                <TextBlock Text="Listening on http://127.0.0.1:17530 for extension intercept requests" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Port 17530" FontFamily="{StaticResource Font.App}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Extension deployment" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,6" />

                    <StackPanel Margin="0,2,0,10">
                        <TextBlock Text="Detected browsers" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="BrowserStatusText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" FontSize="11.5" Margin="0,2,0,8" />

                        <Button Content="Install Extension Guide…" Style="{StaticResource Button.Secondary}" Click="OpenExtensionHelper_Click" Height="26" Padding="12,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <!-- 4. PAGE: YOUTUBE & MEDIA -->
                <StackPanel x:Name="PanelYouTube" Visibility="Collapsed">
                    <TextBlock Text="YouTube &amp; Media Downloader" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Extract and download streaming video, audio, and playlists powered by yt-dlp, FFmpeg, and QuickJS." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Engine status &amp; activation" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="YtStatusBadgeTitle" Text="YouTube Downloader Engine" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock x:Name="YtStatusBadgeSub" Text="Inactive — Click Activate to download plugins" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="YtActivateBtn" Grid.Column="1" Content="Activate" Style="{StaticResource Button.Secondary}" Padding="14,0" Height="26" VerticalAlignment="Center" Click="YtActivateBtn_Click" />
                    </Grid>

                    <Border x:Name="YtProgressCard" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,2,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="YtProgressStatusText" Text="Downloading plugins…" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" DockPanel.Dock="Left" />
                                <TextBlock x:Name="YtProgressPctText" Text="0%" FontSize="11.5" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <ProgressBar x:Name="YtProgressBar" Style="{StaticResource ProgressBar.Thin}" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="YtPluginsCard" Visibility="Collapsed">
                        <TextBlock Text="Core plugins &amp; runtimes" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,6" />

                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="yt-dlp Engine" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock x:Name="YtDlpVersionText" Grid.Column="1" Text="v2026.01.15" FontSize="11.5" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Active" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                        </Grid>

                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FFmpeg Converter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Essentials Build" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Active" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                        </Grid>

                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="QuickJS Runtime" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="JS Engine" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="Active" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="YtAuthCard" Visibility="Collapsed">
                        <TextBlock Text="Authentication &amp; access" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,8,0,6" />

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="YouTube account sign-in" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="Unlock age-restricted, private, and member-only media." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="NativeSignInBtn" Grid.Column="1" Content="Sign in to YouTube…" Style="{StaticResource Button.Secondary}" Height="26" Padding="12,0" VerticalAlignment="Center" Click="NativeSignInBtn_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 5. PAGE: BEHAVIOR -->
                <StackPanel x:Name="PanelBehavior" Visibility="Collapsed">
                    <TextBlock Text="Behavior &amp; Automation" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Configure post-download file integrity verification, automation scripts, and system integration." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="File integrity &amp; scripts" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <CheckBox x:Name="ChecksumBox" Content="Verify file integrity with SHA-256 checksum upon completion" FontSize="12" Margin="0,2,0,8" />

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Run post-download script" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Execute program or script when a download finishes (passes file path as argument)." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ScriptBox" Height="26" VerticalContentAlignment="Center" FontSize="12" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Button.Secondary}" Click="ScriptBrowseClick" Margin="6,0,0,0" Height="26" Padding="12,0" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="System integration &amp; tray" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,6" />

                    <CheckBox x:Name="NotifyBox" Content="Show Windows desktop notification when a download finishes" FontSize="12" Margin="0,2,0,6" />
                    <CheckBox x:Name="TrayProgressBox" Content="Show floating download progress overlay" FontSize="12" Margin="0,2,0,6" />
                    <CheckBox x:Name="MinimizeToTrayBox" Content="Minimize to notification area (system tray) on close" FontSize="12" Margin="0,2,0,6" />
                    <CheckBox x:Name="RunAtStartupBox" Content="Start WDM automatically when Windows logs in" FontSize="12" Margin="0,2,0,6" />
                </StackPanel>

                <!-- 6. PAGE: APPEARANCE -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Customize color themes, visual contrast, and high-DPI font rendering." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Color theme" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Dark theme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Use Windows 11 dark mode across all application surfaces and dialogs." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="DarkModeBox" Grid.Column="1" VerticalAlignment="Center" Checked="DarkMode_Changed" Unchecked="DarkMode_Changed" />
                    </Grid>

                    <TextBlock Text="Typography &amp; rendering" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,6" />

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Type system" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Segoe UI Variable for UI typography." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Subpixel ClearType" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Surface hierarchy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Fluent layered surfaces with subtle 1px border dividers." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Fluent Native" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- 7. PAGE: UPDATES -->
                <StackPanel x:Name="PanelUpdates" Visibility="Collapsed">
                    <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Manage automatic update checks and upgrade to the latest stable release of WDM." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Automatic checks" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <CheckBox x:Name="CheckForUpdatesBox" Content="Check for updates automatically when WDM starts" FontSize="12" Margin="0,2,0,10" />

                    <TextBlock Text="Version status" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,6" />

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current version:" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontSize="12" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Latest version:" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock x:Name="LatestVersionText" Grid.Column="1" FontSize="12" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                    </Grid>

                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckNowButton" Content="Check now" Style="{StaticResource Button.Secondary}" Click="CheckNowClick" Height="26" Padding="14,0" Margin="0,0,8,0" />
                        <Button x:Name="OpenReleaseButton" Content="Open release page" Style="{StaticResource Button.Secondary}" Click="OpenReleaseClick" Height="26" Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="DownloadInstallButton" Content="Download &amp; Install" Style="{StaticResource Button.Secondary}" Click="DownloadInstallClick" Height="26" Padding="14,0" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- 8. PAGE: ADVANCED -->
                <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                    <TextBlock Text="Advanced" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Technical system diagnostics, multi-segment engine configuration, and data management." FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,10" />

                    <TextBlock Text="Engine &amp; runtime diagnostics" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6" />

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target runtime" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text=".NET 8.0 Windows Desktop Runtime (x64) with WPF hardware acceleration." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text=".NET 8.0" FontFamily="{StaticResource Font.App}" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Download engine architecture" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Asynchronous multi-segment range worker with stream pooling." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="HTTP 206 Partial" FontFamily="{StaticResource Font.App}" FontSize="11.5" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Storage &amp; cache" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,6" />

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Settings storage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="Persisted in %APPDATA%\WDM\settings.json with atomic flush." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0.5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="JSON Store" FontFamily="{StaticResource Font.App}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
