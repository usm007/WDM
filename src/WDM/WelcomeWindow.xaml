<Window x:Class="WDM.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to WDM"
        Width="640" Height="640"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        UseLayoutRounding="True"
        ShowInTaskbar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Welcome to WDM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                <TextBlock Text="Let's get your downloading environment set up before you start." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Content Area with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- Step 1: Browser Extension -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Browser Extension (Essential)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <TextBlock Text="To automatically catch downloads from your web browsers, install the WDM extension." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Firefox Section -->
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Firefox" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                                <TextBlock Text="Install directly from the official Mozilla Add-ons store:" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,8" />
                                <Button Content="Install for Firefox..." Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Height="32" Padding="16,0" Click="FirefoxBtn_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Chrome / Edge / Chromium Section -->
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Chrome, Edge &amp; Chromium Browsers" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="CopyPathButton" Content="Copy Extension Path" Style="{StaticResource Button.Secondary}" Height="32" Padding="14,0" Click="CopyPath_Click" Margin="0,0,8,0" />
                                    <Button Content="Open Extensions Page" Style="{StaticResource Button.Secondary}" Height="32" Padding="14,0" Click="OpenExtensions_Click" />
                                </StackPanel>

                                <TextBlock Text="1. Click 'Copy Extension Path'." FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                                <TextBlock Text="2. Click 'Open Extensions Page' (chrome://extensions or edge://extensions)." FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                                <TextBlock Text="3. Enable 'Developer mode' (toggle switch in the top-right corner)." FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                                <TextBlock Text="4. Click 'Load unpacked' and select the extension folder path you copied." FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
                                <TextBlock x:Name="CopyFeedbackText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Accent}" FontWeight="Medium" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Step 2: YouTube Downloader -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="2. YouTube Downloader (Optional)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <TextBlock Text="Download videos, playlists, and audio from YouTube. Authenticate for private or age-restricted content." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="ActivateBtn" Content="Download Plugins &amp; Activate" Style="{StaticResource Button.Accent}" Height="32" Padding="16,0" Click="ActivateBtn_Click" Margin="0,0,8,0" />
                            <Button x:Name="YouTubeBtn" Content="Sign in to YouTube (Optional)" Style="{StaticResource Button.Secondary}" Height="32" Padding="16,0" Click="YouTubeBtn_Click" IsEnabled="False" />
                        </StackPanel>

                        <!-- Progress Bar Card -->
                        <Border x:Name="ProgressCard" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Visibility="Collapsed" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="ProgressStatusText" Text="Downloading plugins..." FontSize="10.5" Foreground="{DynamicResource Brush.TextDim}" />
                                    <TextBlock x:Name="ProgressPctText" Text="0%" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Background="{DynamicResource Brush.SurfaceHover}" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Note: Core media plugins (yt-dlp, FFmpeg) will be downloaded automatically when activated." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Button Content="Finish Setup" Style="{StaticResource Button.Accent}" HorizontalAlignment="Right" Height="32" MinWidth="120" Padding="16,0"
                    IsDefault="True" IsCancel="True" ToolTip="Finish setup (Enter / Esc)" Click="FinishBtn_Click" />
        </Border>
    </Grid>
</Window>
