<Window x:Class="WDM.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WDM"
        Icon="Assets/WDM.ico"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
            </Grid.RowDefinitions>

            <!-- Top Close Button -->
            <Button Style="{StaticResource Button.DialogClose}" Click="CloseClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="10" />

            <!-- Main Body (Clean Branding) -->
            <StackPanel Grid.Row="0" Margin="24,24,24,18" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="12"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Windows Download Manager" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" Margin="0,0,0,3" />

                <TextBlock x:Name="VersionText" Text="Version 2.5" FontSize="12.5" FontFamily="{StaticResource Font.App}"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Text="Native Windows 11 high-throughput download manager."
                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />

                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/usm007/WDM" Click="Link_Click"
                               Foreground="{DynamicResource Brush.Accent}" FontSize="12">
                        <Run Text="github.com/usm007/WDM" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Bottom Action Strip -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="UpdateStatusText" Grid.Column="0" Text="" FontSize="11.5"
                               Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdateButton" Content="Check for updates" Style="{StaticResource Button.Secondary}"
                                MinWidth="110" Height="28" Margin="0,0,8,0" Click="CheckUpdateClick" />
                        <Button Content="Close" Style="{StaticResource Button.Accent}" IsDefault="True" IsCancel="True"
                                MinWidth="75" Height="28" Click="CloseClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
