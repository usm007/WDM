<Window x:Class="WDM.AboutDialog"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WDM"
        Icon="Assets/WDM.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Close Button (always visible) -->
            <Button Style="{StaticResource Button.DialogClose}" Click="CloseClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="10" />

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="24,24,24,12">
                <!-- Branding -->
                <Border Width="56" Height="56" CornerRadius="12"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Windows Download Manager" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" Margin="0,0,0,3" />

                <TextBlock x:Name="VersionText" Text="Version 2.7.3" FontSize="12.5" FontFamily="{StaticResource Font.App}"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Text="Native Windows 11 high-throughput download manager."
                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />

                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Hyperlink NavigateUri="https://github.com/usm007/WDM" Click="Link_Click"
                               Foreground="{DynamicResource Brush.Accent}" FontSize="12">
                        <Run Text="github.com/usm007/WDM" />
                    </Hyperlink>
                </TextBlock>

                <!-- Inline Update Available Panel — hidden until Check finds an update -->
                <Border x:Name="InlineUpdatePanel" Visibility="Collapsed"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: icon + title (dismiss via Later / window close — no redundant inner X) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18"
                                            Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="A New Version is Available" FontSize="15" FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Version line -->
                        <TextBlock x:Name="InlineVersionLine" Grid.Row="1" Margin="14,4,14,0"
                                    FontSize="12.5" FontFamily="{StaticResource Font.App}"
                                    Foreground="{DynamicResource Brush.Accent}" Text="WDM 2.7.2 is available"/>

                        <!-- Status / details -->
                        <TextBlock x:Name="InlineStatusText" Grid.Row="2" Margin="14,6,14,12"
                                    FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                    TextWrapping="Wrap" LineHeight="15"
                                    Text="Downloading the full installer…"/>

                        <!-- Progress area — becomes visible during download, matches screenshot card -->
                        <Border x:Name="InlineProgressPanel" Grid.Row="2" Visibility="Collapsed"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="14,8,14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InlineProgressStatusText"
                                                Grid.Column="0"
                                                Text="Downloading full installer…" FontSize="11.5" FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.Text}"
                                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="InlineProgressPctText"
                                                Grid.Column="1"
                                                Text="27%" FontSize="11.5" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.Accent}"
                                                VerticalAlignment="Center" TextAlignment="Right" MinWidth="44" Margin="8,0,0,0"/>
                                </Grid>
                                <ProgressBar x:Name="InlineDownloadProgressBar"
                                              Style="{StaticResource ProgressBar.Thin}"
                                              Height="6" Minimum="0" Maximum="100" Value="27" Margin="0,6,0,2"
                                              Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock x:Name="InlineProgressDetailText"
                                            Text="Downloading full installer package for this release."
                                            FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}"
                                            Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- When progress is active we swap InlineStatusText for InlineProgressPanel — handled in code -->
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom Action Strip — switches content when inline panel is active -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <Grid>
                    <!-- Default strip -->
                    <Grid x:Name="DefaultStrip">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateStatusText" Grid.Column="0" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="CheckUpdateButton" Content="Check for updates" Appearance="Secondary"
                                       Style="{StaticResource Button.SecondaryAction}"
                                        MinWidth="110" Height="32" Margin="0,0,8,0" Click="CheckUpdateClick" />
                            <ui:Button Content="Close" Appearance="Primary" IsDefault="True" IsCancel="True"
                                       Style="{StaticResource Button.PrimaryAction}"
                                        MinWidth="75" Height="32" Click="CloseClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Update-action strip — replaces DefaultStrip when update is available (matches screenshot footer) -->
                    <Grid x:Name="UpdateActionStrip" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:Button x:Name="InlineLaterButton" Content="Later" Appearance="Secondary"
                                       Style="{StaticResource Button.SecondaryAction}"
                                        MinWidth="85" Height="32" Margin="0,0,8,0" Click="InlineDismissClick"/>
                            <ui:Button x:Name="InlineInstallButton" Content="Download &amp; Install" Appearance="Primary"
                                       Style="{StaticResource Button.PrimaryAction}"
                                        MinWidth="140" Height="32" IsDefault="True" Click="InlineInstallClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

