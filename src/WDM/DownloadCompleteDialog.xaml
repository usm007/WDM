<Window x:Class="WDM.DownloadCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Complete â€” WDM"
        Icon="Assets/WDM.ico"
        Width="500"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Success Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.StatusCompleteSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="&#xF05E0;" FontFamily="{StaticResource Font.Icon}" FontSize="20"
                           Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Download Complete!" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="FileTitleText" Text="filename.ext" FontSize="12" Foreground="{DynamicResource Brush.TextDim}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="380" />
            </StackPanel>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,16" />

        <!-- URL Row -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Address" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Brush.Accent}" Height="28" Padding="8,0" />
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Click="CopyUrl_Click"
                        Padding="10,0" Margin="8,0,0,0" Height="28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0770;" FontFamily="{StaticResource Font.Icon}" FontSize="11" Margin="0,0,4,0" />
                        <TextBlock Text="Copy" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Path Row -->
        <Grid Grid.Row="3" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Saved as" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" IsReadOnly="True" VerticalContentAlignment="Center" Height="28" Padding="8,0" />
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Click="CopyPath_Click"
                        Padding="10,0" Margin="8,0,0,0" Height="28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0770;" FontFamily="{StaticResource Font.Icon}" FontSize="11" Margin="0,0,4,0" />
                        <TextBlock Text="Copy" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Stats Row (Size + Time) -->
        <Grid Grid.Row="4" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Total size" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,2" />
                <TextBlock x:Name="SizeText" Text="0 MB" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Completed at" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,2" />
                <TextBlock x:Name="DateText" Text="Just now" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button Content="Open file" Style="{StaticResource Button.Accent}" Click="OpenFile_Click"
                    MinWidth="110" Height="32" Padding="16,0" DockPanel.Dock="Left" Margin="0,0,8,0" />
            <Button Content="Open folder" Style="{StaticResource Button.Secondary}" Click="OpenFolder_Click"
                    MinWidth="110" Height="32" Padding="16,0" DockPanel.Dock="Left" />
            <Button Content="Close" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="CloseClick"
                    MinWidth="90" Height="32" Padding="16,0" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>

