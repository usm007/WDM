<Window x:Class="WDM.DuplicateDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Download — WDM"
        Icon="Assets/WDM.ico"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.Text}">

    <Border Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Warning Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Brush.WarningSoft}"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0026;" FontFamily="{StaticResource Font.Icon}"
                               FontSize="18" Foreground="{DynamicResource Brush.Warning}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Duplicate Download Captured" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                    <TextBlock Text="This URL or file is already in your download list or target folder."
                               FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Details Card -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Original File:" FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextDim}" Width="90" DockPanel.Dock="Left" />
                        <TextBlock x:Name="OriginalFileText" Text="filename.zip" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="Rename to:" FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextDim}" Width="90" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF000C;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="NumberedFileText" Text="filename (1).zip" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 3. Actions Footer -->
            <DockPanel Grid.Row="2">
                <Button x:Name="SkipBtn" Content="Skip Download" Style="{StaticResource Button.Secondary}"
                        Click="Skip_Click" Padding="16,0" Height="32" DockPanel.Dock="Left" MinWidth="110" />

                <Button x:Name="DownloadBtn" Content="Download with Numbered Name" Style="{StaticResource Button.Accent}"
                        Click="DownloadNumbered_Click" Padding="18,0" Height="32" DockPanel.Dock="Right" MinWidth="190" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
