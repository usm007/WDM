<Window x:Class="WDM.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WDM"
        Icon="Assets/WDM.ico"
        Width="460"
        Height="370"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Logo Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,14,0" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.10" Color="#40464D" />
                </Border.Effect>
                <Image Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WDM" Style="{StaticResource Text.Brand}" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="VersionText" Text="Version 1.0" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                <TextBlock Text="A warm, fast download manager." FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Product Details -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Browser integration:" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBlock Grid.Column="1" Text="Active (127.0.0.1:17530)" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Engine capabilities:" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBlock Grid.Column="1" Text="Multithreaded chunks, resume, speed limiter" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="Multithreaded chunks, resume, speed limiter" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Related Projects -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Other projects by me" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,8" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Kivoy — YouTube downloader" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink x:Name="KivoyLink" NavigateUri="https://github.com/usm007/Kivoy/releases" Click="Link_Click"
                               Foreground="{DynamicResource Brush.Accent}" FontSize="11">
                        <Run Text="github.com/usm007/Kivoy/releases" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Teleflow — Telegram downloader" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink x:Name="TeleflowLink" NavigateUri="https://github.com/usm007/Teleflow/releases" Click="Link_Click"
                               Foreground="{DynamicResource Brush.Accent}" FontSize="11">
                        <Run Text="github.com/usm007/Teleflow/releases" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Action Buttons (pinned to the true bottom of the window) -->
        <DockPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="UpdateStatusText" DockPanel.Dock="Left" Text="" FontSize="11" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center" />
            <Button Content="Close" DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" IsDefault="True" IsCancel="True" MinWidth="100" Height="30" Click="CloseClick" />
            <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource Button.Secondary}" MinWidth="130" Height="30" Margin="0,0,10,0" Click="CheckUpdateClick" />
        </DockPanel>
    </Grid>
</Window>
