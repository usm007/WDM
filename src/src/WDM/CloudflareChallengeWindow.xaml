<Window x:Class="WDM.CloudflareChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cloudflare Protection Solver" Height="580" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Instructions Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="{DynamicResource Brush.AccentSoft}"
                        DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0026;" FontFamily="{StaticResource Font.Icon}"
                               FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cloudflare Verification Required" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,2" />
                    <TextBlock x:Name="StatusText"
                               Text="Complete the Cloudflare check below. WDM will automatically capture clearance cookies and resume your download."
                               FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2 Challenge Browser -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border x:Name="LoadingOverlay" Background="{DynamicResource Brush.Bg}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0349;" FontFamily="{StaticResource Font.Icon}" FontSize="28"
                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Initializing browser session..." FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel>
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                        Click="Cancel_Click" Padding="16,0" Height="30" DockPanel.Dock="Left" />

                <Button x:Name="UseCookiesBtn" Content="Apply Clearance &amp; Resume Download"
                        Style="{StaticResource Button.Accent}" Click="ApplyClearance_Click"
                        Padding="18,0" Height="30" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
