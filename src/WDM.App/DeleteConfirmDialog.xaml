<Window x:Class="WDM.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Delete Downloads — WDM"
        Icon="Assets/WDM.ico"
        Width="400"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="16,14,16,12">
                <!-- Title & Icon Header + Close Button -->
                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.DialogClose}" Click="CancelClick" VerticalAlignment="Center" Margin="6,-6,-6,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18"
                                       Foreground="{DynamicResource Brush.StatusFailed}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Delete Downloads" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Description / Context -->
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,10" />

                <!-- Secondary Option: Delete from disk -->
                <CheckBox x:Name="DiskCheckBox" Content="Also delete the downloaded file from disk"
                          FontSize="11.5" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,2" />
            </StackPanel>

            <!-- Bottom Action Strip -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.SecondaryAction}" MinWidth="85" Height="32" IsCancel="True" Margin="0,0,8,0" Click="CancelClick" />
                    <ui:Button x:Name="DeleteButton" Appearance="Danger" MinWidth="85" Height="32" IsDefault="True" Click="DeleteClick">
                        <TextBlock Text="Delete" Foreground="White" VerticalAlignment="Center" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

