<Window x:Class="WDM.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Update Available — WDM"
        Icon="Assets/WDM.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        Topmost="True">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="8" Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.16" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="20,18,20,16">
                <!-- Header with Download Cloud Icon (dismiss via Later / window close — no redundant inner X) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20"
                                    Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="A New Version is Available" FontSize="20" FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Version subtitle -->
                <TextBlock x:Name="VersionLine" FontSize="13" FontFamily="{StaticResource Font.App}"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,12" />

                <!-- Release Details -->
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource Brush.TextDim}" LineHeight="18" />
                </ScrollViewer>

                <!-- Update Progress (hidden until download starts) -->
                <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressStatusText" Grid.Column="0" Text="Downloading update package…" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ProgressPctText" Grid.Column="1" Text="0%" FontSize="11.5" FontFamily="{StaticResource Font.App}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" TextAlignment="Right" MinWidth="44" Margin="8,0,0,0" />
                        </Grid>
                        <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ProgressBar.Thin}" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,2" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock x:Name="ProgressDetailText" Text="Only the update package (~2-15 MB) is being downloaded, not the full installer." FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Action Strip -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterButton" Content="Later" Style="{StaticResource Button.Secondary}"
                            IsCancel="True" Click="LaterClick" MinWidth="85" Height="28" Margin="0,0,8,0" />
                    <Button x:Name="InstallButton" Content="Download &amp; Install" Style="{StaticResource Button.Accent}"
                            Click="InstallClick" MinWidth="140" Height="28" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

