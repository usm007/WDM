<Window x:Class="WDM.TrayProgressPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WDM Progress"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False"
        Focusable="True"
        PreviewKeyDown="Panel_PreviewKeyDown"
        MouseLeftButtonDown="Pill_MouseLeftButtonDown"
        MouseMove="Pill_MouseMove"
        MouseLeftButtonUp="Pill_MouseLeftButtonUp">
    <!-- Compact pill: icon + count badge + short % + short MB/s; MinWidth only,
         so short text shrinks the pill instead of stretching it -->
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6,2"
            SnapsToDevicePixels="True"
            Focusable="True"
            ToolTip="Download progress. Drag to move. Press Esc to hide.">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Download arrow with active-count badge -->
            <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12"
                               Foreground="{DynamicResource Brush.TextDim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border CornerRadius="7" MinWidth="14" Height="14" Padding="2,0"
                        Background="{DynamicResource Brush.Accent}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-2,-3,0">
                    <TextBlock Text="{Binding ActiveCountText}"
                               FontSize="8" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </Border>
            </Grid>

            <!-- Short area: "5% · 9.6 MB/s" — grows only as needed, never blank -->
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="{StaticResource Font.App}"
                       FontSize="11"
                       FontWeight="Normal"
                       Foreground="{DynamicResource Brush.Text}"
                       VerticalAlignment="Center"
                       MinWidth="86"
                       TextAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Border>
</Window>
