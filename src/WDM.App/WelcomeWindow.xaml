<ui:FluentWindow x:Class="WDM.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Welcome to WDM"
        Icon="Assets/WDM.ico"
        Width="640" Height="660"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Brush.Bg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Welcome to WDM">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <Border Grid.Row="1" Padding="20,16" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Welcome to WDM" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                <TextBlock Text="Let's get your downloading environment set up before you start." FontSize="13" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Content Area with ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- Step 1: Browser Extension -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Browser Extension (Essential)" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <TextBlock Text="To automatically catch downloads from your browsers, install the WDM extension." FontSize="13" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Chrome / Edge / Chromium Section — 3-step tutorial -->
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Chrome, Edge, Brave &amp; Opera" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Text="·  3 steps" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- Step 1: open page -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Open Extensions page" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="or type chrome://extensions / edge://extensions" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,1,0,6" />
                                        <ui:Button x:Name="SetupChromeBtn"
                                                   Content="Open Extensions Page  →"
                                                   Style="{StaticResource Button.PrimaryAction}"
                                                   Height="30" Padding="14,0"
                                                   HorizontalAlignment="Left"
                                                   Click="SetupChrome_Click"
                                                   ToolTip="Copies the extension path and opens the extensions page" />
                                    </StackPanel>
                                </Grid>

                                <!-- Step 2: developer mode -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="2" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Turn ON Developer mode (top-right toggle)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="This reveals the 'Load unpacked' button." FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Step 3: load unpacked + path -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Success}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="3" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Click Load unpacked → paste path → Select Folder" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,6,0,6" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ExtensionPathBox" Grid.Column="0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         FontFamily="{StaticResource Font.Code}" FontSize="11" Foreground="{DynamicResource Brush.Text}"
                                                         Padding="8,6" VerticalContentAlignment="Center"
                                                         Text="%LOCALAPPDATA%\WDM\BrowserExtension" />
                                                <ui:Button x:Name="CopyPathBtn" Grid.Column="1" Appearance="Secondary" Height="24" Padding="8,0" Margin="4" Click="CopyPath_Click" ToolTip="Copy path">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="11" Margin="0,0,4,0" />
                                                        <TextBlock x:Name="CopyPathLabel" Text="Copy" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="ChromeStepsPanel" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓" Foreground="{DynamicResource Brush.Success}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="Path copied — paste it in the folder picker (Ctrl+L → paste → Enter)." FontSize="11" Foreground="#166534" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="CopyFeedbackText" Text="" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Firefox Section -->
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Firefox" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button Content="Install Firefox Extension  →" Style="{StaticResource Button.SecondaryAction}"
                                           HorizontalAlignment="Left" Height="34" Padding="16,0"
                                           Click="FirefoxBtn_Click"
                                           ToolTip="Opens the official Mozilla Add-ons page — one click to install" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Step 2: YouTube & Media Plugins -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="2. High-Speed Media Downloader (Optional)" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <TextBlock Text="Download videos, playlists, audio tracks, and HLS streams at maximum speed." FontSize="13" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button x:Name="ActivateBtn" Content="Activate YouTube Media Engine" Style="{StaticResource Button.SecondaryAction}" Height="32" Padding="16,0" Click="ActivateBtn_Click" Margin="0,0,10,0" />
                            <ui:Button x:Name="YouTubeBtn" Content="Sign In to YouTube (Optional)" Style="{StaticResource Button.SecondaryAction}" Height="32" Padding="16,0" Click="YouTubeBtn_Click" IsEnabled="False" />
                        </StackPanel>

                        <!-- Progress Bar Card -->
                        <Border x:Name="ProgressCard" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Visibility="Collapsed" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="ProgressStatusText" Text="Downloading plugins..." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" />
                                    <TextBlock x:Name="ProgressPctText" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Background="{DynamicResource Brush.SurfaceHover}" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Note: Core media plugins (yt-dlp, FFmpeg) will be downloaded automatically when activated." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="20,14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <ui:Button Content="Finish Setup" Style="{StaticResource Button.PrimaryAction}" HorizontalAlignment="Right" Height="32" MinWidth="120" Padding="16,0"
                       IsDefault="True" IsCancel="True" ToolTip="Finish setup (Enter / Esc)" Click="FinishBtn_Click" />
        </Border>
    </Grid>
</ui:FluentWindow>
