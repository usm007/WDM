<ui:FluentWindow x:Class="WDM.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Media Setup"
        Icon="Assets/WDM.ico"
        Width="620" Height="430"
        MinWidth="540" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Brush.Bg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Media Setup">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <Border Grid.Row="1" Padding="20,16" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Media Setup" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" />
                <TextBlock Text="Set up the YouTube media engine to download videos, playlists and audio." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Content Area with ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- YouTube & Media Plugins -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Media Downloader (Optional)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <TextBlock Text="Download videos, playlists, audio tracks, and HLS streams for offline viewing." FontSize="12" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button x:Name="ActivateBtn" Content="Activate YouTube Media Engine" Style="{StaticResource Button.SecondaryAction}" Height="32" Padding="16,0" Click="ActivateBtn_Click" Margin="0,0,10,0" />
                            <ui:Button x:Name="YouTubeBtn" Content="Sign In to YouTube (Optional)" Style="{StaticResource Button.SecondaryAction}" Height="32" Padding="16,0" Click="YouTubeBtn_Click" IsEnabled="False" />
                        </StackPanel>

                        <!-- Progress Bar Card -->
                        <Border x:Name="ProgressCard" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" Visibility="Collapsed" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="ProgressStatusText" Text="Downloading plugins..." FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                                    <TextBlock x:Name="ProgressPctText" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Background="{DynamicResource Brush.SurfaceHover}" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Note: Core media plugins (yt-dlp, FFmpeg) will be downloaded automatically when activated." FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="20,14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <ui:Button Content="Got it" Style="{StaticResource Button.PrimaryAction}" HorizontalAlignment="Right" Height="32" MinWidth="120" Padding="16,0"
                       IsDefault="True" IsCancel="True" ToolTip="Close (Enter / Esc)" Click="FinishBtn_Click" />
        </Border>
    </Grid>
</ui:FluentWindow>
