<Window x:Class="WDM.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Add Download"
         AutomationProperties.AutomationId="AddDownloadDialogWindow"
         Icon="Assets/WDM.ico"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderThickness="0"
            CornerRadius="0" Margin="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Content Body -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Strip -->
            </Grid.RowDefinitions>

            <!-- Main Body -->
            <StackPanel Grid.Row="0" Margin="16,14,16,12">
                <!-- Header with Category Badge and Close Button -->
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel x:Name="FileCategoryBadge" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="FileCategoryIcon" Symbol="Document24" FontSize="12"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="FileCategoryLabel" Text="File" FontSize="10.5" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Add Download" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Enter the source link and destination settings." FontSize="10.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1.5,0,0" />
                    </StackPanel>
                </DockPanel>

            <!-- Form Fields Grid -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- URL -->
                    <RowDefinition Height="Auto" /> <!-- Save to -->
                    <RowDefinition Height="Auto" /> <!-- File name -->
                    <RowDefinition Height="Auto" /> <!-- Category -->
                    <RowDefinition Height="Auto" /> <!-- YouTube Options -->
                    <RowDefinition Height="Auto" /> <!-- HLS Options -->
                    <RowDefinition Height="Auto" /> <!-- Advanced Options -->
                </Grid.RowDefinitions>

                <!-- URL -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <ui:TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center"
                                Padding="8,0" Height="32" FontSize="12" FontFamily="{StaticResource Font.App}"
                                PlaceholderText="https://example.com/file.zip" ClearButtonEnabled="True"
                                AutomationProperties.AutomationId="UrlBox"
                                AutomationProperties.Name="Download URL" />
                    <Border x:Name="ProbeBadge" CornerRadius="3" Padding="6,3" Margin="0,4,0,0" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceAlt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- YouTube thumbnail -->
                            <Image x:Name="YtThumbnail" Grid.Column="0" Width="64" Height="36"
                                   Stretch="UniformToFill" Margin="0,0,8,0" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                 <Image.Clip>
                                     <RectangleGeometry RadiusX="3" RadiusY="3" Rect="0,0,64,36" />
                                 </Image.Clip>
                             </Image>
                            <ui:SymbolIcon x:Name="ProbeIcon" Grid.Column="1" Symbol="ArrowSync24" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}">
                                <ui:SymbolIcon.RenderTransform>
                                    <RotateTransform x:Name="ProbeSpin" Angle="0" CenterX="7" CenterY="7" />
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                            <TextBlock x:Name="ProbeText" Grid.Column="2" Text="Analyzing link..." FontSize="11"
                                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ui:Button x:Name="YtSignInButton" Grid.Column="3" Content="Sign In" Visibility="Collapsed"
                                       Appearance="Primary" Padding="10,2" FontSize="10.5" Height="24"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Click="YtSignInButton_Click" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="DuplicateWarning" Visibility="Collapsed" FontSize="11"
                               Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0"
                               Text="This URL is already in your download list." />
                </StackPanel>

                <!-- Save to -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Save to" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"
                                Padding="8,0" Height="32" FontSize="12" PlaceholderText="Download folder"
                                AutomationProperties.AutomationId="FolderBox"
                                AutomationProperties.Name="Destination folder" />
                    <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                               Click="BrowseClick" Margin="6,0,0,0" Padding="12,0" Height="32" />
                </Grid>

                <!-- File name -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="File name" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"
                                VerticalContentAlignment="Center" Padding="8,0" Height="32" FontSize="12"
                                PlaceholderText="File name" ClearButtonEnabled="True"
                                AutomationProperties.AutomationId="NameBox"
                                AutomationProperties.Name="File name" />
                    <ui:Button Grid.Column="1" x:Name="SyncTitleButton" Content="Sync title" Appearance="Secondary"
                               Click="SyncTitle_Click" Margin="6,0,0,0" Padding="12,0" Height="32" FontSize="11"
                               ToolTip="Fetch the video title from the source page (info endpoints, then page metadata)" />
                </Grid>

                <!-- Category -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,10" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged"
                          AutomationProperties.AutomationId="CategoryBox"
                          Height="28" Margin="0,0,0,10">
                    <ComboBoxItem Content="Auto detect" Tag="Auto" />
                    <ComboBoxItem Content="Video" Tag="Video" />
                    <ComboBoxItem Content="Music" Tag="Music" />
                    <ComboBoxItem Content="Document" Tag="Document" />
                    <ComboBoxItem Content="Compressed" Tag="Compressed" />
                    <ComboBoxItem Content="Program" Tag="Program" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>

                <!-- YouTube Download Options -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="YouTubePanel"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="YouTube Media Options" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="YtTypeVideoAudio" Content="Video + Audio" GroupName="YtType" IsChecked="True" Checked="YtType_Changed" Margin="0,0,16,0" FontSize="12" />
                            <RadioButton x:Name="YtTypeVideoOnly" Content="Video only" GroupName="YtType" Checked="YtType_Changed" Margin="0,0,16,0" FontSize="12" />
                            <RadioButton x:Name="YtTypeAudioOnly" Content="Audio only" GroupName="YtType" Checked="YtType_Changed" FontSize="12" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="YtQualityLabel" Text="Quality" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="YtQualityBox" Height="28" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="YtContainerPanel">
                                <TextBlock Text="Container" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="YtContainerBox" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="" />
                                    <ComboBoxItem Content="MP4" Tag="mp4" />
                                    <ComboBoxItem Content="WebM" Tag="webm" />
                                    <ComboBoxItem Content="MKV" Tag="mkv" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="YtAudioFormatPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Audio format" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="YtAudioFormatBox" Height="28" Width="140" SelectedIndex="0" SelectionChanged="YtAudioFormat_Changed">
                                <ComboBoxItem Content="Best (original)" Tag="best" />
                                <ComboBoxItem Content="MP3" Tag="mp3" />
                                <ComboBoxItem Content="M4A" Tag="m4a" />
                                <ComboBoxItem Content="Opus" Tag="opus" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="YtEmbedThumb" Content="Embed thumbnail" IsChecked="True" FontSize="12" Margin="0,0,16,0" />
                            <CheckBox x:Name="YtEmbedSubs" Content="Embed subtitles" IsChecked="True" FontSize="12" />
                        </StackPanel>

                        <!-- Playlist picker: full video list, everything ticked by default -->
                        <StackPanel x:Name="YtPlaylistPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                <TextBlock x:Name="YtPlaylistCount" DockPanel.Dock="Left" Text="Playlist videos"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <ui:Button x:Name="YtSelectAllBtn" Content="Select all" Appearance="Secondary"
                                               Padding="10,0" Height="24" FontSize="10.5" Margin="0,0,6,0"
                                               Click="YtSelectAll_Click" />
                                    <ui:Button x:Name="YtSelectNoneBtn" Content="Select none" Appearance="Secondary"
                                               Padding="10,0" Height="24" FontSize="10.5"
                                               Click="YtSelectNone_Click" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="YtPlaylistBox" MaxHeight="200"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource Brush.Surface}"
                                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Display}" FontSize="11.5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="YtPlaylistHint" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                                       Text="Each video downloads as its own item with its own title." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- HLS Quality Options -->
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="HlsPanel"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="HLS Stream Quality" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="HlsQualityLabel" Text="Quality" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="HlsQualityBox" Height="28" SelectionChanged="HlsQualityBox_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Container" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="HlsContainerBox" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto (TS → MP4 remux)" Tag="" />
                                    <ComboBoxItem Content="Keep .ts" Tag="keep-ts" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced options -->
                <Expander Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          Header="Advanced options" Foreground="{DynamicResource Brush.TextDim}"
                          FontSize="11" FontWeight="Medium" Margin="0,0,0,6">
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Segment threads" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ComboBox x:Name="ChunksBox" Height="28">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="0" />
                                    <ComboBoxItem Content="1 thread" Tag="1" />
                                    <ComboBoxItem Content="2 threads" Tag="2" />
                                    <ComboBoxItem Content="4 threads" Tag="4" />
                                    <ComboBoxItem Content="8 threads" Tag="8" />
                                    <ComboBoxItem Content="16 threads" Tag="16" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Speed limit (KB/s)" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="SpeedBox" Text="0" ToolTip="0 = Unlimited"
                                            VerticalContentAlignment="Center" Padding="6,0" Height="32" FontSize="12"
                                            PlaceholderText="0"
                                            AutomationProperties.Name="Speed limit" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Mirror URLs (one per line)" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                            <ui:TextBox x:Name="MirrorsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                        VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="11.5"
                                        FontFamily="{StaticResource Font.App}" PlaceholderText="One URL per line"
                                        AutomationProperties.Name="Mirror URLs" />
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Custom headers (Header: Value)" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,3" />
                            <ui:TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                        VerticalScrollBarVisibility="Auto" Padding="6,4" FontSize="11.5"
                                        FontFamily="{StaticResource Font.App}" PlaceholderText="Header: Value"
                                        AutomationProperties.Name="Custom headers" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </StackPanel>

        <!-- Bottom Action Strip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="16,10">
            <DockPanel LastChildFill="True">
                <ui:Button x:Name="DownloadLaterButton" DockPanel.Dock="Left" Content="Download later" Style="{StaticResource Button.SecondaryAction}"
                           AutomationProperties.AutomationId="BtnDownloadLater"
                           Click="DownloadLaterClick" MinWidth="105" Height="32" Margin="0,0,10,0" IsEnabled="False" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button Content="Cancel" Style="{StaticResource Button.SecondaryAction}" IsCancel="True" Click="CancelClick"
                               AutomationProperties.AutomationId="BtnCancel"
                               MinWidth="75" Height="32" Margin="0,0,8,0" />
                    <ui:Button x:Name="OkButton" Content="Start download" Style="{StaticResource Button.PrimaryAction}"
                               AutomationProperties.AutomationId="BtnStartDownload"
                               Click="OkClick" MinWidth="110" Height="32" IsEnabled="False" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="StartHint" Text="Enter a valid URL above to continue"
                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           VerticalAlignment="Center" Visibility="Visible" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>

