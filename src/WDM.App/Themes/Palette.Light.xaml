<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ LIGHT PALETTE — Windows 11 Fluent Light + Electric Blue CTA Accent ============ -->
    <!-- Neutral tokens (mica canvas #F3F3F3: regions sit directly on it, cards float above) -->
    <Color x:Key="Color.Bg">#F3F3F3</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F3F5F9</Color>
    <Color x:Key="Color.SurfaceHover">#E9E9E9</Color>
    <Color x:Key="Color.CommandBarBg">#F3F6FA</Color>
    <Color x:Key="Color.Border">#D9D9D9</Color>
    <Color x:Key="Color.BorderStrong">#A6A6A6</Color>
    <Color x:Key="Color.GridLine">#F5F5F5</Color>
    <Color x:Key="Color.Text">#111111</Color>
    <Color x:Key="Color.TextDim">#334155</Color>
    <Color x:Key="Color.TextMuted">#475569</Color>

    <!-- Accent — electric primary blue -->
    <Color x:Key="Color.Accent">#1865F2</Color>
    <Color x:Key="Color.AccentDark">#0C52D9</Color>
    <Color x:Key="Color.AccentSoft">#E4EEFF</Color>
    <Color x:Key="Color.AccentSoftStrong">#CCE0FF</Color>

    <!-- AccentFg — foreground on accent-coloured surfaces -->
    <Color x:Key="Color.AccentFg">#FFFFFF</Color>

    <!-- Primary CTA Gradient Colors (Light Mode: Electric Blue) -->
    <Color x:Key="Color.CtaGradientStart">#1A6AFE</Color>
    <Color x:Key="Color.CtaGradientEnd">#0B52D9</Color>

    <!-- Active Sidebar Selection (file: neutral black/6% pill, dark text) -->
    <Color x:Key="Color.SidebarSelectedStart">#DFDFDF</Color>
    <Color x:Key="Color.SidebarSelectedEnd">#DFDFDF</Color>
    <Color x:Key="Color.SidebarSelectedText">#1A1A1A</Color>

    <!-- Semantic status colors -->
    <Color x:Key="Color.StatusActive">#1865F2</Color>
    <Color x:Key="Color.StatusComplete">#16A34A</Color>
    <Color x:Key="Color.StatusFailed">#EF4444</Color>
    <Color x:Key="Color.StatusPaused">#F59E0B</Color>
    <Color x:Key="Color.StatusQueued">#7C3AED</Color>

    <!-- Soft tints for status elements -->
    <Color x:Key="Color.StatusActiveSoft">#FCFDFF</Color>
    <Color x:Key="Color.StatusCompleteSoft">#E7F6ED</Color>
    <Color x:Key="Color.StatusFailedSoft">#FDECEC</Color>
    <Color x:Key="Color.StatusPausedSoft">#FEF5E6</Color>
    <Color x:Key="Color.StatusQueuedSoft">#F2EBFD</Color>

    <!-- Semantic aliases -->
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>

    <!-- Disabled state: readable slate on light disabled fill (WCAG AA for UI text) -->
    <Color x:Key="Color.DisabledBg">#E9EEF4</Color>
    <Color x:Key="Color.DisabledFg">#475569</Color>

    <!-- Zones -->
    <Color x:Key="Color.Track">#E2E8F0</Color>
    <Color x:Key="Color.Sidebar">#F8FAFD</Color>
    <Color x:Key="Color.RowAlt">#F8FAFC</Color>
    <Color x:Key="Color.RowHover">#EFEFEF</Color>
    <Color x:Key="Color.RowSelected">#E2EEFF</Color>

    <!-- Per-category icon tints -->
    <Color x:Key="Color.CatAll">#1865F2</Color>
    <Color x:Key="Color.CatCompressed">#D97706</Color>
    <Color x:Key="Color.CatDocument">#2563EB</Color>
    <Color x:Key="Color.CatMusic">#10B981</Color>
    <Color x:Key="Color.CatProgram">#2563EB</Color>
    <Color x:Key="Color.CatVideo">#9333EA</Color>

    <!-- Soft file-type icon grey (lighter than body text) -->
    <Color x:Key="Color.IconGrey">#5B6B85</Color>

    <!-- Scrollbar thumb: very light shade resting on white, accent on hover -->
    <Color x:Key="Color.ScrollThumb">#DDE1E8</Color>

    <!-- Layer wash: quiet tonal panel for nav/ribbon regions (layer, not card — no shadow) -->
    <Color x:Key="Color.Layer">#E9EBEF</Color>

    <!-- Background-design tokens (mockup): translucent bar wash, workspace
         whisper tint, sidebar wash. Dark values stay near-solid dark. -->
    <Color x:Key="Color.BarBg">#FAFAFA</Color>
    <Color x:Key="Color.WorkspaceBg">#EFEFEF</Color>
    <Color x:Key="Color.SidebarBg">#F3F3F3</Color>
    <Color x:Key="Color.SidebarEdge">#E7E7E7</Color>

    <!-- Card stroke: the subtle 1px contour Windows pairs with elevation shadows
         (Fluent 2: Windows uses strokes instead of key shadows). Softer than control borders. -->
    <Color x:Key="Color.CardStroke">#EDEDED</Color>

    <!-- Sidebar promo card gradient -->
    <Color x:Key="Color.PromoStart">#FFFFFF</Color>
    <Color x:Key="Color.PromoEnd">#EAF3FF</Color>

    <!-- Palette Brushes -->
    <SolidColorBrush x:Key="Brush.Bg"              Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.CommandBarBg"    Color="{StaticResource Color.CommandBarBg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.GridLine" Color="{StaticResource Color.GridLine}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="{StaticResource Color.AccentSoftStrong}" />
    <SolidColorBrush x:Key="Brush.AccentFg"         Color="{StaticResource Color.AccentFg}" />

    <LinearGradientBrush x:Key="Brush.CtaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.CtaGradientStart}" />
        <GradientStop Offset="1" Color="{StaticResource Color.CtaGradientEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SidebarSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color.SidebarSelectedStart}" />
        <GradientStop Offset="1" Color="{StaticResource Color.SidebarSelectedEnd}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarSelectedText" Color="{StaticResource Color.SidebarSelectedText}" />

    <SolidColorBrush x:Key="Brush.StatusActive" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.StatusComplete" Color="{StaticResource Color.StatusComplete}" />
    <SolidColorBrush x:Key="Brush.StatusFailed" Color="{StaticResource Color.StatusFailed}" />
    <SolidColorBrush x:Key="Brush.StatusPaused" Color="{StaticResource Color.StatusPaused}" />
    <SolidColorBrush x:Key="Brush.StatusQueued" Color="{StaticResource Color.StatusQueued}" />
    <SolidColorBrush x:Key="Brush.StatusActiveSoft" Color="{StaticResource Color.StatusActiveSoft}" />
    <SolidColorBrush x:Key="Brush.StatusCompleteSoft" Color="{StaticResource Color.StatusCompleteSoft}" />
    <SolidColorBrush x:Key="Brush.StatusFailedSoft" Color="{StaticResource Color.StatusFailedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusPausedSoft" Color="{StaticResource Color.StatusPausedSoft}" />
    <SolidColorBrush x:Key="Brush.StatusQueuedSoft" Color="{StaticResource Color.StatusQueuedSoft}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{StaticResource Color.DisabledBg}" />
    <SolidColorBrush x:Key="Brush.DisabledFg" Color="{StaticResource Color.DisabledFg}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="{StaticResource Color.RowAlt}" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="{StaticResource Color.RowSelected}" />

    <SolidColorBrush x:Key="Brush.CatAll" Color="{StaticResource Color.CatAll}" />
    <SolidColorBrush x:Key="Brush.CatCompressed" Color="{StaticResource Color.CatCompressed}" />
    <SolidColorBrush x:Key="Brush.CatDocument" Color="{StaticResource Color.CatDocument}" />
    <SolidColorBrush x:Key="Brush.CatMusic" Color="{StaticResource Color.CatMusic}" />
    <SolidColorBrush x:Key="Brush.CatProgram" Color="{StaticResource Color.CatProgram}" />
    <SolidColorBrush x:Key="Brush.CatVideo" Color="{StaticResource Color.CatVideo}" />
    <SolidColorBrush x:Key="Brush.IconGrey" Color="{StaticResource Color.IconGrey}" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}" />
    <SolidColorBrush x:Key="Brush.CardStroke" Color="{StaticResource Color.CardStroke}" />
    <SolidColorBrush x:Key="Brush.BarBg" Color="{StaticResource Color.BarBg}" />
    <SolidColorBrush x:Key="Brush.WorkspaceBg" Color="{StaticResource Color.WorkspaceBg}" />
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="{StaticResource Color.SidebarBg}" />
    <SolidColorBrush x:Key="Brush.SidebarEdge" Color="{StaticResource Color.SidebarEdge}" />
    <SolidColorBrush x:Key="Brush.Layer" Color="{StaticResource Color.Layer}" />
    <SolidColorBrush x:Key="Brush.DialogBorder" Color="{StaticResource Color.CardStroke}" />
    <SolidColorBrush x:Key="Brush.PromoStart" Color="{StaticResource Color.PromoStart}" />
    <SolidColorBrush x:Key="Brush.PromoEnd" Color="{StaticResource Color.PromoEnd}" />

    <!-- Shadow effects — Windows elevation ramp: card = 8, dialog = 64, control = 2.
         Cards pair a 1px CardStroke contour with the ambient shadow (no key shadow on Windows). -->
    <DropShadowEffect x:Key="Shadow.Button"       BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#1865F2" />
    <DropShadowEffect x:Key="Shadow.ButtonStrong" BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#1865F2" />
    <DropShadowEffect x:Key="Shadow.Input"        BlurRadius="10" ShadowDepth="1" Opacity="0.08" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.InputFocus"   BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#1677E8" />
    <DropShadowEffect x:Key="Shadow.Card"         BlurRadius="6" ShadowDepth="0" Opacity="0.04" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.CardDialog"   BlurRadius="32" ShadowDepth="6" Opacity="0.22" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.Popup"        BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.ToolbarPill"  BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#0F172A" />
    <!-- R-13: single focal glow. Primary CTA keeps blue glow; logo glow removed so glow appears once. -->
    <DropShadowEffect x:Key="Shadow.Logo"         BlurRadius="0"  ShadowDepth="0" Opacity="0" Color="#000000" />

    <!-- Windows 11 Fluent WPF-UI Text On Accent overrides: White text on blue primary buttons -->
    <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnAccentFillColorSecondary">#E0E7FF</Color>
    <Color x:Key="TextOnAccentFillColorDisabled">#475569</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E0E7FF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#475569" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#475569" />

    <!-- Windows 11 Fluent WPF-UI Accent Button tokens aligned to WDM Electric Blue #1865F2 -->
    <Color x:Key="SystemAccentColor">#1865F2</Color>
    <Color x:Key="SystemAccentColorPrimary">#1865F2</Color>
    <Color x:Key="SystemAccentColorSecondary">#0C52D9</Color>
    <Color x:Key="SystemAccentColorTertiary">#0A47BC</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#1865F2" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#0C52D9" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#0A47BC" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#1865F2" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0C52D9" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0A47BC" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#1865F2" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#0C52D9" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#0A47BC" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1865F2" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0C52D9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0A47BC" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#E9EEF4" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#475569" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#D9D9D9" />

    <!-- WPF-UI Standard Button disabled state overrides (ensures all secondary and accent buttons have crisp, solid borders and clear backgrounds) -->
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E9EEF4" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#475569" />

</ResourceDictionary>
