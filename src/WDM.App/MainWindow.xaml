<ui:FluentWindow x:Class="WDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WDM"
        xmlns:vm="clr-namespace:WDM.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Windows Download Manager"
        Icon="Assets/WDM.ico"
        Width="760"
        Height="450"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        ContentRendered="Window_ContentRendered"
        Background="{DynamicResource Brush.Bg}">
    <ui:FluentWindow.Resources>
        <vm:TaskStatusToColorConverter x:Key="StatusColor" />
        <vm:CategoryToSymbolConverter x:Key="CategorySymbol" />
        <vm:TaskStatusToBrushConverter x:Key="StatusBrush" />
        <vm:StatusToBrushConverter x:Key="StatusToBrush" />
        <vm:StatusToIconConverter x:Key="StatusToIcon" />
        <vm:EmptyDashConverter x:Key="EmptyDash" />
        <vm:TextToVisibilityConverter x:Key="TextToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:RetryVisibilityConverter x:Key="RetryVis" />
        <vm:NullToVisibilityConverter x:Key="NullToVis" />
        <vm:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
        <vm:BoolToGridLengthConverter x:Key="BoolToGridLen" />
        <!-- DataContext proxy for ColumnDefinitions (non-visual: no
             RelativeSource/ElementName works there, incl. row templates). -->
        <vm:BindingProxy x:Key="WideProxy" Data="{Binding IsWideLayout}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sidebar action link button (e.g. Browser Integration) -->
        <Style x:Key="SidebarLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenAddDialogCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OptionsCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Windows 11 Fluent TitleBar -->
            <RowDefinition Height="1" />    <!-- 1. Faint hairline under the title bar -->
            <RowDefinition Height="Auto" /> <!-- 2. Command Bar Strip -->
            <RowDefinition Height="*" />    <!-- 3. Main Workspace -->
            <RowDefinition Height="Auto" /> <!-- 4. Bottom Status Bar Strip -->
        </Grid.RowDefinitions>

        <!-- 0. Windows 11 Fluent TitleBar with Snap Layouts (Native 32px height) -->
        <ui:TitleBar Grid.Row="0" Title="Windows Download Manager" Height="32" Foreground="{DynamicResource Brush.Text}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 1. Top Command Bar Strip -->
        <!-- 1. Faint hairline under the title bar (mica background design) -->
        <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.CardStroke}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

        <!-- 2. Top Command Bar (own layer: #FAFAFA band, bottom hairline) -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.BarBg}" Padding="16,8,16,8" Margin="0"
                BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Right Action / Utility Area -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input (flat field, no accent underline) -->
                    <Grid Width="200" Height="28" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Height="28"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 Padding="28,0,26,0"
                                 FontSize="11" FontFamily="{StaticResource Font.App}"
                                 Foreground="{DynamicResource Brush.Text}"
                                 CaretBrush="{DynamicResource Brush.Accent}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search downloads (Ctrl+F)"
                                 AutomationProperties.AutomationId="SearchBox"
                                 AutomationProperties.Name="Search downloads"
                                 AutomationProperties.HelpText="Filter the download list by text">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" SnapsToDevicePixels="True">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="{DynamicResource Brush.TextDim}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                                       IsHitTestVisible="False" />
                        <TextBlock Text="Search downloads…" FontSize="11" FontFamily="{StaticResource Font.App}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Clear search" Click="SearchClear_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.CommandBarIcon}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="9" Foreground="{DynamicResource Brush.TextDim}" />
                        </Button>
                    </Grid>


                    <!-- Utility Controls: Settings, Theme, About -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding OptionsCommand}" ToolTip="Settings (Ctrl+,)"
                            AutomationProperties.AutomationId="BtnSettings" AutomationProperties.Name="Settings">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeButtonToolTip}"
                            AutomationProperties.AutomationId="BtnToggleTheme" AutomationProperties.Name="Toggle Theme">
                        <ui:SymbolIcon Symbol="{Binding ThemeSymbol}" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding AboutCommand}" ToolTip="{Binding AboutButtonToolTip}"
                            AutomationProperties.AutomationId="BtnAbout" AutomationProperties.Name="{Binding AboutButtonToolTip}">
                        <ui:SymbolIcon Symbol="{Binding AboutButtonSymbol}" FontSize="18" Foreground="{DynamicResource Brush.Accent}">
                            <ui:SymbolIcon.RenderTransform>
                                <TranslateTransform Y="0" />
                            </ui:SymbolIcon.RenderTransform>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="UpdateBounce">
                                                    <Storyboard RepeatBehavior="1x" AutoReverse="True"><!-- MOTION 1: single nudge on appearance, never looping. -->
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                          From="0" To="-3" Duration="0:0:0.55">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="UpdateBounce" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                </StackPanel>

                <!-- Left Action Controls: + Add Download & Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Add Download (Primary CTA) -->
                    <Button Style="{StaticResource Button.PrimaryFilled}" Command="{Binding OpenAddDialogCommand}" ToolTip="Add Download (Ctrl+N)"
                            Height="28"
                            AutomationProperties.AutomationId="BtnAddDownload"
                            AutomationProperties.Name="Add download">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Arrow-down-into-tray mark, verbatim from the provided SVG -->
                            <Viewbox Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                                          Stroke="White" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Download" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- (toolbar rule removed — grouped by spacing) -->

                    <!-- Action 1: Resume -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding BulkResumeCommand}" ToolTip="Resume download(s) (Enter)"
                            Margin="8,0,0,0"
                            AutomationProperties.AutomationId="BtnResume" AutomationProperties.Name="Resume">
                        <ui:SymbolIcon Symbol="Play24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <!-- Action 2: Pause -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding BulkPauseCommand}" ToolTip="Pause download(s) (Space)"
                            AutomationProperties.AutomationId="BtnPause" AutomationProperties.Name="Pause">
                        <ui:SymbolIcon Symbol="Pause24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <!-- Action 3: Stop All -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding PauseAllCommand}" ToolTip="Stop all active downloads"
                            AutomationProperties.AutomationId="BtnStopAll" AutomationProperties.Name="Stop all">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <!-- (toolbar rule removed — grouped by spacing) -->

                    <!-- Action 4: Delete -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding BulkRemoveCommand}" ToolTip="Delete selected download(s) (Del)"
                            Margin="8,0,0,0"
                            AutomationProperties.AutomationId="BtnDelete" AutomationProperties.Name="Delete">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <!-- Action 5: Clear -->
                    <Button Style="{StaticResource Button.CommandBarIcon}" Command="{Binding ClearCompletedCommand}" ToolTip="Clear finished downloads"
                            AutomationProperties.AutomationId="BtnClearCompleted" AutomationProperties.Name="Clear finished downloads">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Main Workspace (whisper tint under sidebar + table card) -->
        <Grid Grid.Row="3" Background="{DynamicResource Brush.WorkspaceBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="126" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
                <!-- Wide-layout side inspector (0 when narrow / no selection) -->
                <ColumnDefinition Width="{Binding InspectorColumnWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (#F3F3F3 + subtle right divider, flush left) -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}" Padding="4,4,4,6" Margin="0"
                    BorderBrush="{DynamicResource Brush.SidebarEdge}" BorderThickness="0,0,1,0">
                <!-- Navigation Categories and Views List (No scroll, clean divider) -->
                <ListBox x:Name="SidebarFilters"
                         AutomationProperties.AutomationId="SidebarFilters"
                         ItemsSource="{Binding Filters}"
                         SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                         SelectedValuePath="Kind"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Style="{StaticResource ListBox.Sidebar}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Section Divider between Views and Categories -->
                                <Border Grid.ColumnSpan="2" Height="1" Background="{DynamicResource Brush.Border}" Margin="6,4,6,4" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True"
                                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />

                                <!-- Item Icon -->
                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text}" Margin="6,0,8,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <!-- Item Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontFamily="{StaticResource Font.App}" VerticalAlignment="Center" TextTrimming="None">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- (vertical divider removed — the sidebar's own edge line + even air does the job) -->

            <!-- Main Content Area: Switches between Downloads, Settings, Extensions.
                 Optical centering per eye: even air on all four sides. -->
            <Grid Grid.Column="2" Margin="4,4,6,4">
                <Border Style="{StaticResource Card.Elevated}" CornerRadius="6" />
                <Grid Background="Transparent" Margin="0,0,0,4">
                
                <!-- VIEW 1: Downloads View (Table Grid + Detail Pane) -->
                <Grid x:Name="DownloadsView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" /> <!-- Header Row -->
                        <RowDefinition Height="*" />  <!-- DataGrid Content -->
                    </Grid.RowDefinitions>

                    <!-- Table Header Strip (file: white + bottom hairline, full-bleed) -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="12,0" Height="22">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="40" />
                                <!-- Wide-layout columns: collapse to 0 below the threshold -->
                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=85}" />
                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=95}" />
                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=70}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="File Name" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Progress" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Size" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Status" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="Speed" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="ETA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Downloads DataGrid List -->
                    <DataGrid Grid.Row="1"
                              x:Name="TaskGrid"
                              AutomationProperties.AutomationId="TaskGrid"
                              ItemsSource="{Binding TasksView}"
                              SelectedItem="{Binding SelectedTask}"
                              SelectionChanged="TaskGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="TaskGrid_PreviewMouseLeftButtonDown"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              RowHeight="36"
                              HeadersVisibility="None"
                              SelectionMode="Extended"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,6"
                              MouseDoubleClick="TaskGrid_MouseDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="A" Modifiers="Control" Command="SelectAll" />
                            <KeyBinding Key="Delete" Command="{Binding BulkRemoveCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding BulkResumeCommand}" />
                            <KeyBinding Key="Return" Command="{Binding BulkResumeCommand}" />
                            <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}" />
                            <KeyBinding Key="F5" Command="{Binding RetryCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open" Command="{Binding OpenFileCommand}" FontWeight="Bold">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Open24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open folder" Command="{Binding RevealCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Resume" Command="{Binding ResumeCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Pause" Command="{Binding PauseCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Pause24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Restart" Command="{Binding RetryCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Stop" Command="{Binding StopCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Stop24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Refresh link..." Command="{Binding RefreshLinkCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Retry with page session" Command="{Binding RetryWithPageSessionCommand}"
                                          ToolTip="Replays this site's login cookies (you approve this site). For 403 access-denied downloads.">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Key24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Clean / format video name" Command="{Binding CleanFileNameCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Wand24" FontSize="13" Foreground="{DynamicResource Brush.Accent}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Priority">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSort24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
                                    <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                                    <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                                </MenuItem>
                                <MenuItem Header="Move up" Command="{Binding MoveUpCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move down" Command="{Binding MoveDownCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Properties..." Command="{Binding PropertiesCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="{DynamicResource Brush.TextDim}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete" Command="{Binding RemoveCommand}" InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{DynamicResource Brush.StatusFailed}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete with file" Command="{Binding RemoveWithFileCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DeleteDismiss24" FontSize="13" Foreground="{DynamicResource Brush.StatusFailed}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,0,12,0" Height="36" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: File Type Icon (solid glyph) -->
                                                <ColumnDefinition Width="34" />
                                                <!-- Col 1: File Name -->
                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                <!-- Col 2: Progress Column (Completion percentage) -->
                                                <ColumnDefinition Width="80" />
                                                <!-- Col 3: Size Column (Downloaded / Total or Downloaded if total unknown) -->
                                                <ColumnDefinition Width="145" />
                                                <!-- Col 4: Open Folder Button -->
                                                <ColumnDefinition Width="40" />
                                                <!-- Wide-layout columns (Status / Speed / ETA) -->
                                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=85}" />
                                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=95}" />
                                                <ColumnDefinition Width="{Binding Data, Source={StaticResource WideProxy}, Converter={StaticResource BoolToGridLen}, ConverterParameter=70}" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: File Type Icon (solid filled glyph, no tile) -->
                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Category, Converter={StaticResource CategorySymbol}}"
                                                           Filled="True" FontSize="17" Foreground="{DynamicResource Brush.IconGrey}"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0" />

                                            <!-- Col 1: File Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayFileName}" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayFileName}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Error}" FontSize="8.5" Foreground="{DynamicResource Brush.StatusFailed}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorDetail}" VerticalAlignment="Center" Margin="0,1.5,0,0"
                                                           Visibility="{Binding HasFailureError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Col 2: Progress (Only completion percentage) -->
                                            <TextBlock Grid.Column="2" Text="{Binding CompletionPercentText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />

                                            <!-- Col 3: Size (Downloaded / Total or Downloaded if total unknown) -->
                                            <TextBlock Grid.Column="3" Text="{Binding DisplaySizeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />

                                            <!-- Col 4: Open Containing Folder Button -->
                                            <ui:Button Grid.Column="4"
                                                       Appearance="Transparent"
                                                       Padding="0"
                                                       Width="26" Height="26"
                                                       Focusable="True"
                                                       ToolTip="Open containing folder"
                                                       Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Folder20" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                                            </ui:Button>

                                            <!-- Col 5: Status (wide layout only) -->
                                            <TextBlock Grid.Column="5" Text="{Binding PrimaryStatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <!-- Col 6: Speed (wide layout only) -->
                                            <TextBlock Grid.Column="6" Text="{Binding SpeedText, Converter={StaticResource EmptyDash}}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextDim}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />

                                            <!-- Col 7: ETA / time (wide layout only) -->
                                            <TextBlock Grid.Column="7" Text="{Binding EtaOrDashText}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextDim}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State Overlay (when no downloads match filter) -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                                Visibility="{Binding HasNoVisibleTasks, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="35"
                                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding EmptyStateSubtitle}" Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="10.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Selected Item Details Inspector Panel (narrow windows only;
                     the side inspector replaces it in the wide layout). Tint, not a rule. -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderThickness="0" CornerRadius="0,0,6,6"
                        Padding="14,8,14,10"
                        Visibility="{Binding IsBottomDetailsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid DataContext="{Binding SelectedTask}">
                        <Grid.ColumnDefinitions>
                            <!-- Left Info Fields Grid -->
                            <ColumnDefinition Width="*" />
                            <!-- Right Progress Bar Section -->
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Metadata Columns -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Top Row: FILE | LOCATION | SOURCE -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="FILE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DisplayFileName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayFileName}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="LOCATION" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SaveFolder}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}"
                                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                                           Focusable="True" MouseDown="LocationText_MouseDown"
                                           AutomationProperties.Name="Open containing folder. Activate with Enter.">
                                    <TextBlock.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullPath}" />
                                            <TextBlock Text="Activate with Enter" FontStyle="Italic" />
                                        </StackPanel>
                                    </TextBlock.ToolTip>
                                    <TextBlock.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="SOURCE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DomainText}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}"
                                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                                           Focusable="True" MouseDown="SourceText_MouseDown"
                                           AutomationProperties.Name="Copy source URL. Activate with Enter.">
                                    <TextBlock.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" />
                                            <TextBlock Text="Activate with Enter" FontStyle="Italic" />
                                        </StackPanel>
                                    </TextBlock.ToolTip>
                                    <TextBlock.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>

                            <!-- Bottom Row: STATUS | SIZE | ADDED -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="STATUS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding PrimaryStatusText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="SIZE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding DisplaySizeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ADDED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding AddedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource Brush.TextDim}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right Progress Bar Section -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="PROGRESS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadedOfTotalText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource ProgressBar.DetailsPanel}"
                                         Value="{Binding Progress}" Maximum="100" Height="6"
                                         Background="{DynamicResource Brush.Track}" Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
                </Grid>
            </Grid>

            <!-- Wide-layout side inspector: selection details + quick actions.
                 Visible only when the window is wide and an item is selected.
                 Its own elevated card — no edge rule. -->
            <Border Grid.Column="3" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1"
                    CornerRadius="8" Margin="8,4,8,8"
                    Effect="{DynamicResource Shadow.Card}"
                    Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="DETAILS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedTask.DisplayFileName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" ToolTip="{Binding SelectedTask.DisplayFileName}" />
                        <TextBlock Text="{Binding SelectedTask.DomainText}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.Url}" Margin="0,2,0,10" />

                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedTask.PrimaryStatusText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding SelectedTask.Status, Converter={StaticResource StatusBrush}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTask.DownloadedOfTotalText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.DetailsPanel}"
                                     Value="{Binding SelectedTask.Progress}" Maximum="100" Height="6" Margin="0,0,0,12"
                                     Background="{DynamicResource Brush.Track}" Foreground="{DynamicResource Brush.Accent}" />

                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="SPEED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.SpeedText, Converter={StaticResource EmptyDash}}" FontSize="11" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="TIME LEFT" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.EtaDetailText}" FontSize="11" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="SIZE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.DisplaySizeText}" FontSize="11" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="CONNECTIONS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.ConnectionsText}" FontSize="11" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="ADDED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.AddedAt, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" FontSize="11" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="SAVED TO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedTask.SaveFolder}" FontSize="11" Foreground="{DynamicResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.FullPath}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="ACTIONS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,6" />
                        <UniformGrid Columns="2">
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Open file" Command="{Binding OpenFileCommand}" Height="30" Margin="0,0,6,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Open folder" Command="{Binding RevealCommand}" Height="30" Margin="0,0,0,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Resume" Command="{Binding ResumeCommand}" Height="30" Margin="0,0,6,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Pause" Command="{Binding PauseCommand}" Height="30" Margin="0,0,0,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Restart" Command="{Binding RetryCommand}" Height="30" Margin="0,0,6,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Refresh link" Command="{Binding RefreshLinkCommand}" Height="30" Margin="0,0,0,6" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Properties" Command="{Binding PropertiesCommand}" Height="30" Margin="0,0,6,0" />
                            <ui:Button Style="{StaticResource Button.SecondaryAction}" Content="Delete" Command="{Binding RemoveCommand}" Height="30" Margin="0,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Full-Overlay Integrated Views (Settings, Extensions, Reload Notice) - Covers Command Bar & Workspace, leaving Titlebar & Bottom Bar visible -->
        <Grid x:Name="SettingsView" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:OptionsControl x:Name="SettingsContent" />
        </Grid>

        <Grid x:Name="ExtensionView" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:BrowserExtensionControl x:Name="ExtensionContent" />
        </Grid>

        <Grid x:Name="NoticeView" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}">
            <local:ExtensionReloadNoticeControl x:Name="NoticeContent" />
        </Grid>

        <!-- 4. Bottom Status Bar — attached translucent strip with top hairline -->
        <Border Grid.Row="4" Height="24" Background="{DynamicResource Brush.BarBg}" Padding="10,0"
                BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="0,1,0,0" Margin="0">
            <DockPanel VerticalAlignment="Center">
                <!-- Right status: Sparkline + Tray Icon + Total Speed -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="SparklineCanvas" Width="55" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusRightText}" FontFamily="{StaticResource Font.App}" Foreground="{DynamicResource Brush.Accent}" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Left status: e.g. 5 downloads · 5 completed (with 5 completed in green) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusPrefixText}" Foreground="{DynamicResource Brush.TextDim}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusCompletedText}" Foreground="{DynamicResource Brush.StatusComplete}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
